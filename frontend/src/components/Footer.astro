---
/**
 * What the site is, how current it is, who the words belong to, and how to be taken out of it.
 *
 * The last of those is not politeness. The inventory is built from what public bodies publish about
 * themselves, without asking them first, so the page that says so is also the page that has to say how to
 * ask for a record to be removed — and it has to say it where somebody would go looking.
 *
 * It offers the countries as one link to the section of the home page that presents them with their
 * figures, rather than as a column of five: a reader who is already inside a country is not choosing one,
 * and the control at the top of every page is where changing it lives.
 *
 * The columns of pages the previous generation's footer carries — about, method, privacy, the history of
 * the project — are not here yet, because those pages are not here yet. A footer link to a page that does
 * not exist is worse than a shorter footer.
 */
import { currentEdition } from "../lib/corpus.ts";
import { editionNamed, words } from "../lib/words.ts";
import { searchPath } from "../../public/search-scope.js";

type Props = { language: string; current?: string };
const { language, current = "/" } = Astro.props;
const text = words(language);

const country = current === "/" ? undefined : current.split("/")[1]?.toUpperCase();

/** The pages about the project itself, in this page's own language, which is the one its reader can read. */
const aboutPath = country ? `/${country.toLowerCase()}/${text.aboutSlug}/` : `/${text.aboutSlug}/`;
const historyPath = country ? `/${country.toLowerCase()}/${text.historySlug}/` : `/${text.historySlug}/`;
---

{/* No margin above it: every page ends in a band with a rule under it, and a gap between that rule and
  the footer's own reads as an empty strip of page rather than as space. */}
<footer class="border-t border-line bg-card">
  <div class="wrap grid gap-8 py-10 md:grid-cols-[2fr_1fr_1fr]">
    <div>
      <a href="/" class="inline-flex min-h-(--spacing-target) items-center text-lg font-bold text-brand-strong no-underline">
        {text.siteName}
      </a>
      <p class="meta mt-2 max-w-3xl">{text.trust}</p>
      <p class="meta mt-3">{editionNamed(currentEdition, language)}</p>
      <p class="meta mt-3">
        {text.optOut}{" "}
        <a class="inline-flex min-h-(--spacing-target) items-center underline" href="mailto:contact@farmsuccession.eu">
          contact@farmsuccession.eu
        </a>
      </p>
    </div>

    <nav aria-label={text.siteNav} class="grid content-start">
      <a class="inline-flex min-h-(--spacing-target) items-center underline" href="/#countries">
        {text.countriesTitle}
      </a>
      <a class="inline-flex min-h-(--spacing-target) items-center underline" href={searchPath("/", country)}>
        {text.searchAction}
      </a>
      <a class="inline-flex min-h-(--spacing-target) items-center underline" href={aboutPath}>
        {text.aboutTitle}
      </a>
      <a class="inline-flex min-h-(--spacing-target) items-center underline" href={historyPath}>
        {text.historyNav}
      </a>
      <a class="inline-flex min-h-(--spacing-target) items-center underline" href={`${aboutPath}#method`}>
        {text.methodTitle}
      </a>
      <a class="inline-flex min-h-(--spacing-target) items-center underline" href={`${aboutPath}#contact`}>
        {text.contactTitle2}
      </a>
      <a class="inline-flex min-h-(--spacing-target) items-center underline" href={`${aboutPath}#privacy`}>
        {text.privacyTitle}
      </a>
    </nav>

    {/* What the site is and whose the words are: two sentences a reader can check the whole inventory
      against, beside the pages rather than folded into one of them. */}
    <div class="grid content-start">
      <p class="meta">{text.notAService}</p>
      <p class="meta mt-3">{text.licence}</p>
    </div>
  </div>
</footer>
