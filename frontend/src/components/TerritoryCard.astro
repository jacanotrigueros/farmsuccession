---
/**
 * One territory on its country's page: one box, a row a finger can hit that leads to the territory, and
 * underneath it, on a country page, the territory's own records behind one disclosure.
 *
 * Every grant to set up for the first time is shown at once, with its whole name: it is what most readers of a
 * country page came for, and the name is what tells two grants apart. Further resources expand in place.
 */
import TerritoryDisclosure from "./TerritoryDisclosure.astro";
import RecordLinks from "./RecordLinks.astro";
import { href, type Territory } from "../lib/corpus.ts";
import { isFirstEstablishmentAid } from "../lib/goals.ts";
import { words } from "../lib/words.ts";

type Props = { child: Territory; language: string; withRecords: boolean; grouping?: string };
const { child, language, withRecords, grouping } = Astro.props;
const text = words(language);

const resources = withRecords ? child.data.resources : [];
const aid = resources.filter(isFirstEstablishmentAid);
const rest = resources.filter((resource) => !isFirstEstablishmentAid(resource));
const hasInheritedOnly = withRecords && resources.length === 0;
---

<li class="territory card flex min-w-0 flex-col">
  <a href={href(child.layer)} class:list={["territory-link", hasInheritedOnly && "grow"]}>
    <span class="font-bold text-brand-strong underline underline-offset-3">{child.data.officialName}</span>
    {hasInheritedOnly && (
      <span class="territory-coverage mt-auto pt-1 text-muted">
        {grouping ? text.inheritedFromGroup.replace("{where}", grouping) : text.inheritedResources}
      </span>
    )}
  </a>
  {aid.length > 0 && <RecordLinks place={child} language={language} resources={aid} featured />}
  {rest.length > 0 && <TerritoryDisclosure place={child} language={language} resources={rest} />}
</li>

<style>
  /* The whole row is the target, and the arrow says it leads somewhere. */
  .territory-link {
    position: relative;
    display: flex;
    min-height: var(--spacing-target);
    flex-direction: column;
    justify-content: flex-start;
    gap: 0.125rem;
    padding: 0.5rem 2.5rem 0.5rem 1rem;
    text-decoration: none;
    overflow-wrap: anywhere;
    border-radius: inherit;
  }
  .territory-coverage {
    font-size: var(--text-control);
    line-height: calc(var(--text-meta) * var(--text-meta--line-height));
  }
  .territory-link::after {
    content: "";
    position: absolute;
    top: calc(var(--spacing-target) / 2 - 0.25rem);
    right: 1rem;
    width: 0.5rem;
    height: 0.5rem;
    border-top: 2px solid var(--color-brand);
    border-right: 2px solid var(--color-brand);
    transform: rotate(45deg);
  }
  .territory-link:hover,
  .territory-link:focus-visible {
    background: var(--color-brand-tint);
  }
</style>
