---
/**
 * The link from a claim to the page that establishes it: a number a reader can follow down to the source
 * list and back.
 *
 * Every dated period, every figure and every contact on a record cites one of the record's own sources, so
 * each of them can carry one of these. It is the smallest possible version of what this whole project is
 * about — no claim without the page it came from — and it is a plain in-page link, so it works with no
 * script and keeps working when the page is printed.
 */
import { words } from "../lib/words.ts";

type Props = { number: number; language: string };
const { number, language } = Astro.props;
const text = words(language);
---

<a
  href={`#source-${number}`}
  class="inline-flex min-h-tap min-w-tap items-center justify-center text-meta no-underline"
  aria-label={`${text.sourceShort} ${number}`}
>
  [{number}]
</a>
