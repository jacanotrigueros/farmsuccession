---
/**
 * The most important sentence on a page nobody has reviewed: one line, in one shape, everywhere a page
 * or a record says so.
 *
 * It used to be a heading and a paragraph in a filled box, on the grounds that the most important
 * sentence on the page may not be the quietest thing on it. In the band at the top of a page that put
 * four lines of warning above the title of the thing the reader came for, and read as more important
 * than the page itself — which is a different lie from the one it was guarding against. It is a line of
 * metadata with a rule down its side now: impossible to miss, impossible to mistake for the page.
 *
 * It says "automatic draft" rather than "unreviewed", because a reader can tell those apart: everything
 * on the page cites a public source, a date and the words that were on it, and automatic checks have
 * passed. What has not happened is a person signing it off.
 */
import { Icon } from "astro-icon/components";
import { ICON } from "../lib/icons.ts";
import { words } from "../lib/words.ts";

type Props = { language: string; class?: string };
const { language, class: className } = Astro.props;
const text = words(language);
---

<p class:list={["flex items-start gap-3 rounded-r-lg border-s-3 border-accent-line bg-card px-4 py-3 text-meta", className]} role="note">
  <Icon name={ICON.draft} aria-hidden="true" class="size-5 shrink-0 text-accent" />
  <span class="text-pretty">{text.draftNotice}</span>
</p>
