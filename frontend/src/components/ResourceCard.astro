---
/**
 * One record as a reader meets it in a list: what kind of thing it is and whether it is operating, then
 * what it is called, what it offers, and underneath the two things that place it — where it applies and
 * who runs it. How many sources it carries is a question about the record, answered on the record's own
 * page; in a list of twenty it was a third row of small print under every one of them.
 *
 * The whole card is the link. The title carries the underline, and an overlay on it covers the card, so a
 * finger can land anywhere on the box and a screen reader is still read one link with the record's name.
 *
 * `compact` bounds titles and footer metadata for scanning. Territory pages give the description
 * one more line than search previews.
 *
 * The state is always printed, even when it is the expected one, because "this exists" and "you can apply
 * today" are different claims and this project exists to keep them apart.
 */
import { resourcePlaceParts } from "../../public/resource-place.js";
import { Icon } from "astro-icon/components";
import KindTag from "./KindTag.astro";
import StatusTag from "./StatusTag.astro";
import { countryTerritories, languageOf, placeOf, recordHref, type Resource, type Territory } from "../lib/corpus.ts";
import { ICON } from "../lib/icons.ts";
import { euCardIn } from "../lib/eu-presentation.ts";
import { words } from "../lib/words.ts";

type Props = {
  resource: Resource;
  /** The territory whose file recorded it: its address, and the place a reader is told it comes from. */
  recordedIn: Territory;
  language: string;
  level?: "h2" | "h3" | "h4";
  compact?: boolean;
  territoryPreview?: boolean;
  /** The country of the page a European card is shown on. */
  country?: string;
};
const { resource, recordedIn, language, level = "h3", compact = false, territoryPreview = false, country } = Astro.props;
const Heading = level;
const recordLanguage = languageOf(recordedIn);
const text = words(language);

/**
 * A European record on a page in another language is presented in that language, with its original name
 * underneath; the record page, its quotes and its official name stay as written (eu-presentation.ts).
 */
const translated = recordedIn.layer.level === "EU" ? euCardIn(resource.id, resource.whatItOffers, language) : undefined;
const cardLanguage = translated ? language : recordLanguage;
const name = translated?.name ?? resource.name;

/**
 * On a country's page, a European card names the country's own record of the measure: the national records
 * whose sources say they apply it (`implements`). Regional applications are listed on the record itself,
 * where there is room for them; on a card they would bury the European measure under its regions.
 */
const home = countryTerritories().find(({ data }) => data.schemaId === "country-snapshot" && data.country === country);
const counterparts =
  recordedIn.layer.level === "EU" && home
    ? home.data.resources.filter((candidate) => candidate.implements?.some(({ resourceId }) => resourceId === resource.id))
    : [];

const place = resourcePlaceParts(placeOf(recordedIn, text.euName, language), resource.scope.area, text.reachRow, text.labelSeparator);
---

<li
  class:list={[
    "relative flex min-w-0 flex-col hyphens-auto [overflow-wrap:anywhere]",
    compact ? "result-row card card-link p-4 sm:p-5" : "resource-card card card-link p-5",
  ]}
  data-kind={resource.kind}
  data-status={resource.status}
>
  <div class="flex flex-wrap items-center gap-x-3 gap-y-2">
    <KindTag kind={resource.kind} language={language} />
    {/* "Active" on a policy framework reads as something to apply for; its other statuses still show. */}
    {!(resource.kind === "POLICY" && resource.status === "ACTIVE") && <StatusTag status={resource.status} language={language} />}
  </div>
  <Heading data-record class="mt-3 text-lg leading-snug font-bold">
    <a
      href={recordHref(resource.id, recordedIn)}
      lang={cardLanguage}
      class="text-brand-strong underline decoration-1 underline-offset-3 after:absolute after:inset-0 hover:decoration-2"
    >
      {compact ? <span class="line-clamp-3">{name}</span> : name}
    </a>
  </Heading>
  {translated && (
    <p class:list={["meta mt-1", territoryPreview && "line-clamp-2"]}>
      {text.originalName.split("{name}")[0]}
      <span lang={recordLanguage}>{resource.name}</span>
      {text.originalName.split("{name}")[1]}
    </p>
  )}
  <p lang={cardLanguage} class:list={["mt-3", compact && !territoryPreview ? "line-clamp-2" : "line-clamp-3"]}>
    {translated?.offers ?? resource.whatItOffers}
  </p>
  {home &&
    counterparts.map((national) => (
      <p class="relative z-10 mt-3" data-counterpart>
        <span class="font-bold">{text.inCountry.replace("{where}", home.data.officialName)}</span>{" "}
        <a
          href={recordHref(national.id, home)}
          lang={languageOf(home)}
          class="inline-flex min-h-(--spacing-target) items-center text-brand-strong underline"
        >
          {national.name}
        </a>
      </p>
    ))}
  {compact ? (
    <p class:list={["meta mt-auto grid gap-x-4 gap-y-1 pt-3", !territoryPreview && "sm:grid-cols-[minmax(0,1fr)_minmax(0,2fr)]"]}>
      <span class="inline-flex min-w-0 items-start gap-1.5">
        <Icon name={ICON.territory} aria-hidden="true" class="mt-0.5 size-4 shrink-0" />
        <span class="line-clamp-1">
          {place.label}
          {place.area && <span lang={recordLanguage}>{place.area}</span>}
        </span>
      </span>
      <span class="inline-flex min-w-0 items-start gap-1.5">
        <Icon name={ICON.operator} aria-hidden="true" class="mt-0.5 size-4 shrink-0" />
        <span lang={recordLanguage} class="line-clamp-1">
          {resource.operator}
        </span>
      </span>
    </p>
  ) : (
    <div class="mt-5 border-t border-line pt-3">
      <p class="meta flex items-start gap-1.5">
        <Icon name={ICON.territory} aria-hidden="true" class="mt-0.5 size-4 shrink-0" />
        <span>
          {place.label}
          {place.area && <span lang={recordLanguage}>{place.area}</span>}
        </span>
      </p>
      <p class="meta mt-1 flex items-start gap-1.5">
        <Icon name={ICON.operator} aria-hidden="true" class="mt-0.5 size-4 shrink-0" />
        <span lang={recordLanguage}>{resource.operator}</span>
      </p>
    </div>
  )}
</li>

<style>
  /* The kind's own colour, as a line along the top of its card: a list of twenty is scannable by colour
     before it is read, and the colour is the one the kind's tag already uses. */
  .resource-card {
    border-top: 3px solid var(--color-brand-tint);
  }
  .resource-card:focus-within {
    border-color: var(--color-brand);
  }
  /* Inside a card the kind reads as the card's own label rather than as a pill on top of a pill. */
  .resource-card :global(.tag-kind) {
    background: transparent;
    padding-inline: 0;
    --tw-ring-color: transparent;
  }
  .result-row :global(.tag-kind) {
    border: 0;
    background: transparent;
    padding-inline: 0;
    color: var(--color-muted);
    --tw-ring-color: transparent;
  }
  .result-row:focus-within {
    background: var(--color-brand-tint);
  }
</style>
