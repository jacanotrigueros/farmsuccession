---
/**
 * Generational renewal in every EU member state, side by side, on Europe's page.
 *
 * All 27 come from the European file's `memberStates` table (Eurostat), so the comparison does not depend on
 * which countries the directory documents yet; a country links to its page only when the site has one
 * (founder, 27 Nov 2026). A table, because 27 countries read best as rows a reader can scan at 320 px and a
 * screen reader can walk. Beside the two age shares sit the number of farms and the agricultural land they come from, so a
 * share is never read without its size (founder, 20 Nov 2026). The rows start sorted by the share aged 65 or
 * over; `/sort.js` lets a reader sort by any column and, without it, the table stays in that order. The EU-27
 * is the reference, so it sits in the footer and never moves.
 *
 * Every cell carries the number it shows in `data-value`, so sorting compares numbers, not formatted text.
 */
import Fold from "./Fold.astro";
import { countryTerritories, euTerritory, href } from "../lib/corpus.ts";
import { countryNameIn } from "../lib/language.ts";
import { words } from "../lib/words.ts";

type Props = { language: string; locale: string };
const { language, locale } = Astro.props;
const labels = words(language).countryContext;
const percent = new Intl.NumberFormat(locale, { style: "percent", minimumFractionDigits: 1, maximumFractionDigits: 1 });
// Farms in thousands and land in millions of hectares, with the unit in the heading: one decimal is enough to
// compare countries, and a locale's own compact suffixes ("M", "Mio.", "mln.") would each need a legend.
const scaled = new Intl.NumberFormat(locale, { minimumFractionDigits: 1, maximumFractionDigits: 1 });
const thousands = (n: number) => scaled.format(n / 1_000);
// Land in millions of hectares with three decimals for every country, so Malta (8,880 ha, 0.009) reads on the
// same scale as Spain (23.459) and no small country rounds to a misleading 0.0 (founder, 27 Nov 2026).
const fine = new Intl.NumberFormat(locale, { minimumFractionDigits: 3, maximumFractionDigits: 3 });
const millions = (n: number) => fine.format(n / 1_000_000);
const whole = new Intl.NumberFormat(locale);

type Ages = { holdings: number; under25: number; from25To34: number; from35To39: number; atLeast65: number };
const older = (table: Ages) => table.atLeast65 / table.holdings;
const younger = (table: Ages) => (table.under25 + table.from25To34 + table.from35To39) / table.holdings;

const rows = countryTerritories().flatMap((territory) =>
  territory.layer.level === "COUNTRY" && territory.data.schemaId === "country-snapshot" && territory.data.countryContext
    ? [{ territory, country: territory.layer.country, context: territory.data.countryContext }]
    : [],
);
// Every country with a page is linked, whether or not its own file carries the statistics yet.
const pages = new Map(
  countryTerritories().flatMap(({ layer }) => (layer.level === "COUNTRY" ? [[layer.country, href(layer)] as const] : [])),
);
const europe = euTerritory()?.data;
const memberStates = europe?.schemaId === "eu-snapshot" ? europe.memberStates : undefined;
const figures = memberStates
  ? memberStates.countries.map(({ country, succession, land }) => ({ country, succession, land }))
  : rows.map(({ country, context }) => ({ country, succession: context.succession, land: context.land }));
const sorted = figures
  .map(({ country, succession, land }) => ({
    href: pages.get(country),
    name: countryNameIn(country, language),
    older: older(succession),
    younger: younger(succession),
    holdings: succession.holdings,
    hectares: land.hectares,
  }))
  .toSorted((a, b) => b.older - a.older);
const europeAges = rows.find(({ context }) => context.succession.europe)?.context.succession.europe;
const europeLand = rows.find(({ context }) => context.land.europe)?.context.land.europe;
const first = figures[0];
const year = first?.succession.year;
const tableOf = (apiUrl: string) =>
  `https://ec.europa.eu/eurostat/databrowser/view/${new URL(apiUrl).pathname.split("/").pop()}/default/table?lang=${["fr", "de"].includes(language) ? language : "en"}`;

const columns = [
  {
    label: labels.olderColumn,
    value: (row: (typeof sorted)[number]) => row.older,
    shown: (n: number) => percent.format(n),
    sort: "descending" as const,
  },
  { label: labels.youngerColumn, value: (row: (typeof sorted)[number]) => row.younger, shown: (n: number) => percent.format(n) },
  {
    label: labels.holdingsColumn,
    unit: labels.holdingsUnit,
    value: (row: (typeof sorted)[number]) => row.holdings,
    shown: thousands,
    full: true,
  },
  { label: labels.landColumn, unit: labels.landUnit, value: (row: (typeof sorted)[number]) => row.hectares, shown: millions, full: true },
];
---

{sorted.length > 1 && year && first && (
  <section class="band wrap border-t border-line py-12" aria-labelledby="age-comparison">
    <Fold>
      <h2 slot="heading" id="age-comparison" class="scroll-mt-6 text-2xl font-bold" tabindex="-1">
        {labels.comparisonTitle}
      </h2>
      <p id="age-comparison-lead" class="mt-2 max-w-5xl text-muted">
        {labels.comparisonLead.replace("{year}", String(year))}
      </p>
      <div class="mt-6 max-w-4xl overflow-x-auto">
        <table class="w-full border-collapse text-left" data-sortable aria-describedby="age-comparison-lead">
          <thead>
            <tr class="border-b-2 border-line-strong align-bottom">
              <th scope="col" class="py-2 px-1 sm:ps-0 sm:pe-4" data-sort="text">
                {labels.countryColumn}
              </th>
              {columns.map(({ label, unit, sort }) => (
                <th scope="col" class="py-2 px-1 sm:ps-0 sm:pe-4 text-right sm:last:pe-0" data-sort="number" aria-sort={sort}>
                  {label}
                  {unit && (
                    <>
                      <br />
                      <span class="font-normal text-muted">{unit}</span>
                    </>
                  )}
                </th>
              ))}
            </tr>
          </thead>
          <tbody>
            {sorted.map((row) => (
              <tr class="border-b border-line">
                <th scope="row" class="py-1 px-1 sm:ps-0 sm:pe-4 font-normal" data-value={row.name}>
                  {row.href ? (
                    <a class="inline-flex min-h-(--spacing-target) items-center underline" href={row.href}>
                      {row.name}
                    </a>
                  ) : (
                    <span class="inline-flex min-h-(--spacing-target) items-center">{row.name}</span>
                  )}
                </th>
                {columns.map(({ value, shown, full }) => (
                  <td
                    class="py-1 px-1 sm:ps-0 sm:pe-4 text-right tabular-nums sm:last:pe-0"
                    data-value={value(row)}
                    title={full ? whole.format(value(row)) : undefined}
                  >
                    {shown(value(row))}
                  </td>
                ))}
              </tr>
            ))}
          </tbody>
          {europeAges && (
            <tfoot>
              <tr class="font-bold">
                <th scope="row" class="py-3 px-1 sm:ps-0 sm:pe-4">
                  {labels.europe}
                </th>
                <td class="py-3 px-1 sm:ps-0 sm:pe-4 text-right tabular-nums">{percent.format(older(europeAges))}</td>
                <td class="py-3 px-1 sm:ps-0 sm:pe-4 text-right tabular-nums">{percent.format(younger(europeAges))}</td>
                <td class="py-3 px-1 sm:ps-0 sm:pe-4 text-right tabular-nums">{thousands(europeAges.holdings)}</td>
                <td class="py-3 text-right tabular-nums">
                  {europeLand && (
                    <>
                      {millions(europeLand.hectares)}
                      {europeLand.flag === "IMPUTED" && <span class="block font-normal text-muted">{labels.imputed}</span>}
                    </>
                  )}
                </td>
              </tr>
            </tfoot>
          )}
        </table>
      </div>
      <p class="mt-3 text-muted">
        {labels.comparisonSource.replace("{year}", String(year))}{" "}
        <a class="inline-flex min-h-(--spacing-target) items-center underline" href={tableOf(first.succession.sourceUrl)}>
          {labels.successionSource}
        </a>
        {" · "}
        <a class="inline-flex min-h-(--spacing-target) items-center underline" href={tableOf(first.land.sourceUrl)}>
          {labels.landSource}
        </a>
      </p>
      <script is:inline type="module" src="/sort.js" defer></script>
    </Fold>
  </section>
)}

<style is:global>
  /* The buttons are made by /sort.js, after the build, so they are styled here and not with utility classes. */
  [data-sortable] th > button {
    /* A whole cell to hit, at least 44 × 44 px, and the unit on its own line under the label. */
    display: inline-block;
    width: 100%;
    min-width: var(--spacing-target);
    min-height: var(--spacing-target);
    padding-block: 0.375rem;
    font: inherit;
    font-weight: 700;
    color: var(--color-brand-strong);
    text-align: inherit;
    text-decoration: underline dotted;
    text-underline-offset: 0.2em;
    cursor: pointer;
  }
  [data-sortable] th.text-right > button {
    text-align: right;
  }
  [data-sortable] th > button::after {
    margin-inline-start: 0.25rem;
    content: "↕" / "";
    color: var(--color-muted);
  }
  [data-sortable] th[aria-sort="descending"] > button::after {
    content: "↓" / "";
    color: inherit;
  }
  [data-sortable] th[aria-sort="ascending"] > button::after {
    content: "↑" / "";
    color: inherit;
  }
</style>
