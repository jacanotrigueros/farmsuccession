---
/**
 * Where the page sits in the territorial tree, widest first.
 *
 * The page you are on is the last item, and a record leaves it out: its name follows immediately as the
 * title, and repeating it cost a phone two or three lines. Either way the trail is also published as
 * structured data, so a search engine is told the same thing a reader is shown.
 *
 * The separator is a slash rather than a chevron: it is one character wide at any size, and a reader who
 * has ever typed an address has read it before.
 */
type Crumb = { label: string; href: string };

type Props = {
  items: readonly Crumb[];
  current: string;
  /** A record hides the page it is on; a territory shows it. */
  showCurrent?: boolean;
  label: string;
};
const { items, current, showCurrent = true, label } = Astro.props;

const trail = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [...items, { label: current, href: Astro.url.pathname }].map((crumb, index) => ({
    "@type": "ListItem",
    position: index + 1,
    name: crumb.label,
    item: new URL(crumb.href, Astro.site).href,
  })),
};
---

<script type="application/ld+json" set:html={JSON.stringify(trail).replaceAll("<", "\u003c")} />
<nav aria-label={label} class="meta" data-pagefind-ignore>
  <ol class="flex flex-wrap items-center gap-x-2">
    {items.map((crumb, index) => (
      <li class="flex items-center gap-x-2">
        <a href={crumb.href} class="inline-flex min-h-(--spacing-target) items-center">
          {crumb.label}
        </a>
        {(showCurrent || index < items.length - 1) && <span aria-hidden="true">/</span>}
      </li>
    ))}
    {showCurrent && (
      <li aria-current="page" class="inline-flex min-h-(--spacing-target) items-center font-bold text-ink">
        {current}
      </li>
    )}
  </ol>
</nav>
