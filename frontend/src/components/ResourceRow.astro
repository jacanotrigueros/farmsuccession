---
/**
 * One record, as a reader meets it in a list: what kind of thing it is and whether it is operating, then
 * what it is called, what it offers, who runs it and what the claim rests on.
 *
 * The tags lead, on a line of their own. They used to sit beside the title, aligned on the text baseline,
 * which put a 44-pixel target and two 32-pixel pills at three different heights in the same row — it read
 * as something broken rather than as a label. Above the title they are what they are: how to tell at a
 * glance whether a row is worth reading, before reading it.
 *
 * No image — the schema has no image field and a grid that is mostly placeholder reads as broken — and no
 * box, so a list of twenty stays lighter than a grid of twenty.
 *
 * The title leads to the record's own page on this site, not straight out to the operator. That is a
 * deliberate step rather than one too many: the official page is what a reader eventually needs, and the
 * record page is where they find out whether it is worth their afternoon — what the application period was,
 * who it is for, which pages say so and when those pages were read. The official link is the most prominent
 * thing on that page.
 *
 * The state is always printed, even when it is the expected one, because the whole point of this project
 * is that "this exists" and "you can apply today" are different claims.
 */
import { Icon } from "astro-icon/components";
import { recordHref, type Resource, type Territory } from "../lib/corpus.ts";
import { ICON } from "../lib/icons.ts";
import { dateIn } from "../lib/language.ts";
import KindTag from "./KindTag.astro";
import StatusTag from "./StatusTag.astro";
import { counted, words } from "../lib/words.ts";

type Props = {
  resource: Resource;
  language: string;
  recordedIn: Territory;
  inherited?: boolean;
  showKind?: boolean;
  /** The level this title takes, which depends on what the list it sits in is headed by. */
  titleAs?: "h3" | "h4";
};
const { resource, language, recordedIn, inherited = false, showKind = true, titleAs = "h3" } = Astro.props;
const Title = titleAs;
const text = words(language);

const consulted = resource.sources
  .map((source) => source.consultedOn)
  .toSorted()
  .at(-1);
const host = new URL(resource.accessUrl).host.replace(/^www\./u, "");
const from = recordedIn.layer.level === "EU" ? text.europe : recordedIn.data.officialName;
---

<article class="border-t border-line py-5 first:border-t-0">
  <div class="flex flex-wrap items-center gap-x-3 gap-y-2">
    {showKind && <KindTag kind={resource.kind} language={language} />}
    <StatusTag status={resource.status} language={language} />
  </div>

  <Title class="mt-2 text-lg leading-snug font-semibold">
    <a href={recordHref(resource.id)} class="inline-flex min-h-(--spacing-target) items-center">
      {resource.name}
    </a>
  </Title>

  <p class="mt-1 max-w-3xl">{resource.whatItOffers}</p>

  <p class="meta mt-3 flex flex-wrap items-start gap-x-4 gap-y-1">
    <span class="inline-flex min-w-0 items-start gap-1.5">
      <Icon name={ICON.operator} aria-hidden="true" class="mt-0.5 size-4 shrink-0" />
      <span>{resource.operator}</span>
    </span>
    {inherited && (
      <span class="inline-flex min-w-0 items-start gap-1.5">
        <Icon name={ICON.territory} aria-hidden="true" class="mt-0.5 size-4 shrink-0" />
        <span>
          {text.inherited} {from}
        </span>
      </span>
    )}
    <span class="inline-flex min-w-0 items-start gap-1.5">
      <Icon name={ICON.evidence} aria-hidden="true" class="mt-0.5 size-4 shrink-0" />
      <span>
        {host} · {counted(resource.sources.length, text.source)}
        {consulted && (
          <>
            {", "}
            {text.readOn} <time datetime={consulted}>{dateIn(consulted, language)}</time>
          </>
        )}
      </span>
    </span>
  </p>
</article>
