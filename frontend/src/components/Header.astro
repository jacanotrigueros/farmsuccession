---
/**
 * The same shell on every page: the wordmark, one explicit control for where you are, and the way in to
 * searching.
 *
 * The territory control is a `<details>`, which the browser opens and closes on its own, so
 * it works without JavaScript. Escape closes it and restores focus when the enhancement is available.
 * The locally hosted flags also render on systems without flag emoji.
 *
 * The search button leads to the search page of the territory the reader is on: written in the same
 * language as the page they came from, and complete before anything is typed.
 */
import { Icon } from "astro-icon/components";
import { countryTerritories, euTerritory, EUROPE_PAGE, href, languageOf } from "../lib/corpus.ts";
import { countryNameIn } from "../lib/language.ts";
import { flagOf, ICON } from "../lib/icons.ts";
import { words } from "../lib/words.ts";
import { searchPath } from "../../public/search-scope.js";

type Props = { current?: string; language: string };
const { current = "/", language } = Astro.props;
const text = words(language);

const europe = euTerritory();
/** The country a page belongs to, which is also the scope its search button leads to. */
const countryOf = (place: string): string | undefined => (place === "/" || place === "/eu/" ? undefined : place.slice(1, -1).toUpperCase());

/**
 * The European Union option leads to the EU layer's own page. Each country is named in the page's language, and, where its own name differs, that name
 * follows on a quieter line: a reader looking for their own country recognises "Nederland" before they
 * translate it.
 */
const places: { href: string; label: string; own?: string; ownLanguage?: string; flag: string }[] = [
  { href: europe ? EUROPE_PAGE : "/", label: text.euName, flag: flagOf("EU") },
  ...countryTerritories()
    .flatMap((territory) => {
      if (territory.layer.level === "EU") return [];
      const label = countryNameIn(territory.layer.country, language);
      const own = territory.data.officialName;
      return [
        {
          href: href(territory.layer),
          label,
          own: own === label ? undefined : own,
          ownLanguage: languageOf(territory),
          flag: flagOf(territory.layer.country),
        },
      ];
    })
    .toSorted((a, b) => a.label.localeCompare(b.label, language)),
];
/**
 * The place a page belongs to is the longest one its path starts with: a region is inside its country.
 * A page that belongs to no place — the home page, which is the overview of every country, or a page
 * about the project — selects nothing and asks the reader to choose, rather than claiming Europe
 * (founder, 16 Nov 2026).
 */
const here = places.filter((place) => current.startsWith(place.href)).toSorted((a, b) => b.href.length - a.href.length)[0];
const searchHref = searchPath("/", countryOf(here?.href ?? "/"));
---

<header class="border-b border-line bg-card">
  <div class="wrap flex flex-wrap items-center gap-x-3 gap-y-2 py-3">
    <a href="/" class="mr-auto flex min-h-(--spacing-target) min-w-0 items-center gap-2 text-lg font-bold no-underline sm:text-xl">
      <img src="/logo-mark.svg" width="32" height="29" alt="" aria-hidden="true" class="shrink-0" />
      <span class="min-w-0 text-brand-strong [overflow-wrap:anywhere]">
        Farm<span class="text-brand">Succession</span>
      </span>
    </a>

    {/* The narrow header puts search on the wordmark row. Only the link for the current layout is focusable. */}
    <a href={searchHref} class="btn btn-quiet w-11 shrink-0 px-0 sm:hidden">
      <Icon name={ICON.search} aria-hidden="true" class="size-5" />
      <span class="sr-only">{text.searchAction}</span>
    </a>

    {europe && (
      <nav aria-label={text.whereToLook} class="w-full sm:w-auto">
        <details class="territory-picker relative">
          <summary class="flex min-h-(--spacing-target) cursor-pointer list-none items-center justify-between gap-2 rounded-lg border border-line-strong bg-card px-3 font-bold text-brand-strong hover:border-brand">
            <span class="flex min-w-0 items-center gap-2">
              {here ? (
                <img src={here.flag} alt="" width="24" height="18" class="h-4.5 w-6 shrink-0 rounded-xs border border-line object-cover" />
              ) : (
                <Icon name={ICON.europe} aria-hidden="true" class="size-5 shrink-0 text-brand" />
              )}
              <span class="min-w-0 truncate">{here?.label ?? text.chooseScope}</span>
            </span>
            <Icon name="lucide:chevron-down" aria-hidden="true" class="territory-chevron size-4 shrink-0" />
          </summary>
          <ul class="territory-options absolute right-0 z-20 mt-2 w-full max-w-[calc(100vw-2rem)] min-w-64 overflow-y-auto overscroll-contain rounded-xl border border-line-strong bg-card p-2 shadow-lg">
            {places.map((place) => (
              <li>
                <a
                  href={place.href}
                  aria-current={place.href === here?.href ? "true" : undefined}
                  class="flex min-h-(--spacing-target) items-center justify-between gap-3 rounded-lg px-3 font-bold text-ink no-underline hover:bg-brand-tint aria-[current]:bg-brand-tint aria-[current]:text-brand-strong"
                >
                  <span class="flex items-center gap-2">
                    <img
                      src={place.flag}
                      alt=""
                      width="24"
                      height="18"
                      class="h-4.5 w-6 shrink-0 rounded-xs border border-line object-cover"
                    />
                    <span class="flex flex-col py-1 leading-tight">
                      {place.label}
                      {place.own && (
                        <span lang={place.ownLanguage} class="meta font-normal">
                          {place.own}
                        </span>
                      )}
                    </span>
                  </span>
                  {place.href === here?.href && <Icon name="lucide:check" aria-hidden="true" class="size-4 shrink-0" />}
                </a>
              </li>
            ))}
          </ul>
        </details>
      </nav>
    )}

    <a href={searchHref} class="btn btn-quiet hidden shrink-0 px-5 sm:inline-flex">
      <Icon name={ICON.search} aria-hidden="true" class="size-5" />
      <span>{text.searchAction}</span>
    </a>
  </div>
</header>

{europe && <script is:inline type="module" src="/territory-picker.js"></script>}

<style>
  summary::-webkit-details-marker {
    display: none;
  }
  .territory-picker[open] summary {
    border-color: var(--color-brand);
  }
  .territory-picker[open] .territory-chevron {
    transform: rotate(180deg);
  }
  .territory-options {
    max-height: min(20rem, 60dvh);
  }
</style>
