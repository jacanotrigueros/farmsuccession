---
/**
 * The same shell on every page: the wordmark, one explicit control for where you are, and the way in to
 * searching.
 *
 * The territory control is a `<details>`, which the browser opens and closes on its own — no script, and
 * it still works with none. The flag beside each name is a pair of regional indicator letters rather than
 * an image, so it costs nothing to fetch and renders in the reader's own system font.
 *
 * The search button leads to the search page of the territory the reader is on: written in the same
 * language as the page they came from, and complete before anything is typed.
 */
import { Icon } from "astro-icon/components";
import { countryTerritories, euTerritory, href } from "../lib/corpus.ts";
import { ICON } from "../lib/icons.ts";
import { words } from "../lib/words.ts";

type Props = { current?: string; language: string };
const { current = "/", language } = Astro.props;
const text = words(language);

/** Two regional indicator letters. The European Union is not an ISO country, and still has a flag. */
const flagOf = (code: string): string => String.fromCodePoint(...[...code.toUpperCase()].map((letter) => 0x1f1a5 + letter.charCodeAt(0)));

const europe = euTerritory();
const places = [
  { href: "/", label: text.europe, flag: flagOf("EU") },
  ...countryTerritories().map((territory) => ({
    href: href(territory.layer),
    label: territory.data.officialName,
    flag: flagOf(territory.layer.level === "EU" ? "EU" : territory.layer.country),
  })),
];
/** The place a page belongs to is the longest one its path starts with: a region is inside its country. */
const here = places.filter((place) => current.startsWith(place.href)).toSorted((a, b) => b.href.length - a.href.length)[0] ?? places[0];
---

<header class="border-b border-line bg-card">
  <div class="wrap flex flex-wrap items-center gap-x-3 gap-y-2 py-3">
    <a href="/" class="mr-auto flex min-h-(--spacing-target) min-w-0 items-center gap-2 text-lg font-bold no-underline sm:text-xl">
      <img src="/logo-mark.svg" width="32" height="29" alt="" aria-hidden="true" class="shrink-0" />
      <span class="min-w-0 text-brand-strong [overflow-wrap:anywhere]">
        Farm<span class="text-brand">Succession</span>
      </span>
    </a>

    {europe && (
      <nav aria-label={text.whereToLook} class="order-3 w-full sm:order-2 sm:w-auto">
        <details class="territory-picker relative">
          <summary class="flex min-h-(--spacing-target) cursor-pointer list-none items-center justify-between gap-2 rounded-lg border border-line-strong bg-card px-3 font-bold text-brand-strong hover:border-brand">
            <span class="flex min-w-0 items-center gap-2">
              <span aria-hidden="true" class="text-lg leading-none">
                {here?.flag}
              </span>
              <span class="min-w-0 truncate">{here?.label}</span>
            </span>
            <Icon name="lucide:chevron-down" aria-hidden="true" class="territory-chevron size-4 shrink-0" />
          </summary>
          <ul class="territory-options absolute right-0 z-20 mt-2 w-full max-w-[calc(100vw-2rem)] min-w-64 overflow-y-auto overscroll-contain rounded-xl border border-line-strong bg-card p-2 shadow-lg">
            {places.map((place) => (
              <li>
                <a
                  href={place.href}
                  aria-current={place.href === here?.href ? "true" : undefined}
                  class="flex min-h-(--spacing-target) items-center justify-between gap-3 rounded-lg px-3 font-bold text-ink no-underline hover:bg-brand-tint aria-[current]:bg-brand-tint aria-[current]:text-brand-strong"
                >
                  <span class="flex items-center gap-2">
                    <span aria-hidden="true" class="text-lg leading-none">
                      {place.flag}
                    </span>
                    {place.label}
                  </span>
                  {place.href === here?.href && <Icon name="lucide:check" aria-hidden="true" class="size-4 shrink-0" />}
                </a>
              </li>
            ))}
          </ul>
        </details>
      </nav>
    )}

    <a href={`${current}search/`} class="btn btn-quiet order-2 w-11 shrink-0 px-0 sm:order-3 sm:w-auto sm:px-5">
      <Icon name={ICON.search} aria-hidden="true" class="size-5" />
      <span class="sr-only sm:not-sr-only">{text.searchAction}</span>
    </a>
  </div>
</header>

<style>
  summary::-webkit-details-marker {
    display: none;
  }
  .territory-picker[open] summary {
    border-color: var(--color-brand);
  }
  .territory-picker[open] .territory-chevron {
    transform: rotate(180deg);
  }
  .territory-options {
    max-height: min(20rem, 60dvh);
  }
</style>
