---
import { reportEndpoint } from "../../reporting.config.mjs";
import { words } from "../lib/words.ts";
import ReportPrivacy from "./ReportPrivacy.astro";

interface Props {
  language: string;
  kind: string;
  subject: string;
}
const { language, kind, subject } = Astro.props;
const text = words(language);
---

{reportEndpoint && (
  <>
    <input type="hidden" name="_subject" value={subject} />
    <input type="hidden" name="_language" value={language === "pt" ? "pt-PT" : language} />
    <input class="hidden" type="text" name="_gotcha" tabindex="-1" autocomplete="off" aria-hidden="true" />
  </>
)}
<ReportPrivacy language={language} />
<div>
  <button type="submit" class="btn btn-primary">
    {reportEndpoint ? text.reportSend : text.reportPrepare}
  </button>
  <p class="mt-4 text-control text-muted">
    {text.reportAlternativeEmail}{" "}
    <a class="inline-flex min-h-(--spacing-target) items-center font-bold underline" href="mailto:contact@farmsuccession.eu">
      contact@farmsuccession.eu
    </a>
  </p>
</div>
{!reportEndpoint && (
  <>
    <p class="meta">{text.reportEmailFallback}</p>
    <div hidden data-mail-draft class="grid gap-4 rounded-lg border border-brand bg-card p-5">
      <p role="status" class="font-bold text-brand-strong">
        {text.reportDraftReady}
      </p>
      <label for={`${kind}-mail-draft`} class="font-bold">
        {text.reportDraftLabel}
      </label>
      <textarea
        id={`${kind}-mail-draft`}
        data-mail-preview
        readonly
        rows="10"
        class="w-full rounded-lg border border-line-strong bg-page p-3"
      ></textarea>
      <a data-open-mail href="mailto:contact@farmsuccession.eu" class="btn btn-primary justify-self-start">
        {text.reportOpenEmail}
      </a>
    </div>
  </>
)}
