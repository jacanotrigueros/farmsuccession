---
/**
 * What is on this page, as a strip of links under the title.
 *
 * It is a strip of its own — its own background and rule — so it reads as navigation rather than as the
 * first thing in the first section. The links wrap onto a second line rather than scrolling sideways,
 * because a link that is off the edge of a phone is a link nobody uses.
 *
 * Links remain short anchors to the page's sections, not a competing set of calls to action. The strip carries
 * no visible «On this page» label: it was the one item in a row of links that was not a link (founder, 28 Nov
 * 2026); the nav keeps it as its accessible name.
 */
import { words } from "../lib/words.ts";

type Props = { sections: ReadonlyArray<{ id: string; label: string }>; language: string };
const { sections, language } = Astro.props;
const text = words(language);
---

<nav aria-label={text.onThisPage} class="page-index border-y border-line bg-page" data-pagefind-ignore>
  <div class="wrap flex flex-wrap items-center gap-x-5 py-2">
    {sections.map(({ id, label }) => (
      <a
        href={`#${id}`}
        class="inline-flex min-h-(--spacing-target) min-w-(--spacing-target) items-center justify-center border-b-2 border-transparent text-control font-bold text-brand-strong no-underline hover:border-brand hover:text-brand"
      >
        {label}
      </a>
    ))}
  </div>
</nav>
