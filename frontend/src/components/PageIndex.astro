---
/**
 * What is on this page, as a strip of links under the title.
 *
 * It is a strip of its own — its own background and rule — so it reads as navigation rather than as the
 * first thing in the first section. The links wrap onto a second line rather than scrolling sideways,
 * because a link that is off the edge of a phone is a link nobody uses.
 *
 * Links remain short anchors to the page's sections, not a competing set of calls to action.
 */
import { words } from "../lib/words.ts";

type Props = { sections: ReadonlyArray<{ id: string; label: string }>; language: string };
const { sections, language } = Astro.props;
const text = words(language);
---

<nav aria-label={text.onThisPage} class="border-y border-line bg-page" data-pagefind-ignore>
  <div class="wrap flex items-center gap-5 overflow-x-auto py-2 [scrollbar-width:thin]">
    <span class="shrink-0 text-meta font-bold text-muted">{text.onThisPage}</span>
    {sections.map(({ id, label }) => (
      <a
        href={`#${id}`}
        class="inline-flex min-h-(--spacing-target) shrink-0 items-center border-b-2 border-transparent text-control font-bold text-brand-strong no-underline hover:border-brand hover:text-brand"
      >
        {label}
      </a>
    ))}
  </div>
</nav>
