---
/**
 * The application periods of a record, directly under what it offers.
 *
 * "Can I apply now?" is the question a reader actually arrives with, and the answer used to be at the
 * bottom of the page, under the figures and the practical details. It is here instead, immediately after
 * the summary, which is where GOV.UK puts it on a grant page and where somebody scanning on a phone will
 * see it.
 *
 * What it must never do is answer that question by looking at today's date. A period's state was judged
 * against the day its source was read; this site is published once a year and cannot know what the page
 * says this afternoon. So every period is printed as a dated statement about a page — "was open, read on 30
 * September 2026" — with a link to the page itself, which is the only thing that can answer for today.
 */
import type { Call, Source } from "../lib/corpus.ts";
import { dateIn } from "../lib/language.ts";
import { callStateLabel } from "../lib/vocabulary.ts";
import { words } from "../lib/words.ts";
import SourceRef from "./SourceRef.astro";

type Props = { calls: readonly Call[]; sources: readonly Source[]; language: string };
const { calls, sources, language } = Astro.props;
const text = words(language);

const numbered = new Map(sources.map((source, index) => [source.url, { number: index + 1, consultedOn: source.consultedOn }]));

/** The window as a reader reads it: both dates where the source gives both, one where it gives one. */
function window(call: Call): string {
  if (call.opens && call.closes) return `${text.from} ${dateIn(call.opens, language)} ${text.until} ${dateIn(call.closes, language)}`;
  if (call.opens) return `${text.from} ${dateIn(call.opens, language)}`;
  if (call.closes) return `${text.until} ${dateIn(call.closes, language)}`;
  return "";
}
---

{calls.length === 0 ? (
  <p class="max-w-measure">{text.noPeriodRecorded}</p>
) : (
  <>
    <ul class="space-y-3">
      {calls.map((call) => {
        const cited = numbered.get(call.sourceUrl);
        const period = window(call);
        return (
          <li class="border-s-2 border-accent ps-4">
            <p class="font-semibold">{call.name}</p>
            <p>
              {callStateLabel(call.state, language)}
              {period && <>, {period}</>}
            </p>
            {cited && (
              <p class="text-meta text-ink-soft">
                {text.recordedOn} <time datetime={cited.consultedOn}>{dateIn(cited.consultedOn, language)}</time>{" "}
                <SourceRef number={cited.number} language={language} />
              </p>
            )}
          </li>
        );
      })}
    </ul>
    <p class="mt-4 max-w-measure text-meta text-ink-soft">{text.periodsExplained}</p>
  </>
)}
