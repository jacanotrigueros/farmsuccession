---
/** Territorial records occupy the available width; no clipped descriptions or cramped columns. */
import ResourceCard from "./ResourceCard.astro";
import type { Resource, Territory } from "../lib/corpus.ts";

type Props = {
  items: readonly { resource: Resource; recordedIn: Territory }[];
  language: string;
  level?: "h2" | "h3" | "h4";
};
const { items, language, level = "h3" } = Astro.props;
---

<ul data-records class="territory-records grid items-start gap-3">
  {items.map(({ resource, recordedIn }) => (
    <ResourceCard resource={resource} recordedIn={recordedIn} language={language} level={level} compact showFullSummary />
  ))}
</ul>

