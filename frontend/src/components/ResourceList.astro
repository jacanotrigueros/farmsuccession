---
/** Divided rows reduce the visual weight of long regional lists; two columns retain a readable measure. */
import ResourceCard from "./ResourceCard.astro";
import type { Resource, Territory } from "../lib/corpus.ts";

type Props = {
  items: readonly { resource: Resource; recordedIn: Territory }[];
  language: string;
  level?: "h2" | "h3" | "h4";
};
const { items, language, level = "h3" } = Astro.props;
---

<ul data-records class="territory-records grid gap-x-8 md:grid-cols-2">
  {items.map(({ resource, recordedIn }) => (
    <ResourceCard resource={resource} recordedIn={recordedIn} language={language} level={level} compact />
  ))}
</ul>

<style>
  /* A grid has two first-row items: the first item must not inherit a list-only padding exception. */
  .territory-records > :global(.result-row:first-child) {
    padding-top: 1.25rem;
  }
</style>
