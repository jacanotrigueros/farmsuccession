---
/**
 * Territorial records in equal-height cards, with two columns when there is room and one otherwise.
 * Each card shows a short preview and links to the full record.
 */
import ResourceCard from "./ResourceCard.astro";
import type { Resource, Territory } from "../lib/corpus.ts";

type Props = {
  items: readonly { resource: Resource; recordedIn: Territory }[];
  language: string;
  level?: "h2" | "h3" | "h4";
  /** The country of the page, so a European card can lead to what that country made of it. */
  country?: string;
};
const { items, language, level = "h3", country } = Astro.props;
---

<ul data-records class="territory-records grid auto-rows-fr grid-cols-1 gap-3 lg:grid-cols-2">
  {items.map(({ resource, recordedIn }) => (
    <ResourceCard
      resource={resource}
      recordedIn={recordedIn}
      language={language}
      level={level}
      country={country}
      compact
      summaryLines={3}
    />
  ))}
</ul>
