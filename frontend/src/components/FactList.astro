---
/**
 * The structured facts of a record: one fact per row, each with the icon of what it is about, its name
 * in small bold type, and the answer under it.
 *
 * The label sits above the value rather than beside it. Several of these names run past fifty characters
 * once translated — "Date la plus récente affichée sur la page officielle" — and a fixed label column
 * wraps those into four lines against a value of two words. Stacked, every row is the same shape at any
 * width, which is what lets the panel sit in a column of its own beside the text.
 *
 * The icon is not decoration: a reader scanning for what a thing costs, or where it applies, finds the
 * row by its mark before reading a word of it. A fact the record does not have is not shown — a label
 * with "unknown" beside it adds a line without adding an answer, and the record already says what it
 * does not know in its own words.
 */
import { Icon } from "astro-icon/components";

type Row = { label: string; value: string; icon: string; datetime?: string; href?: string };

type Props = { rows: readonly Row[] };
const { rows } = Astro.props;
---

<dl class="mt-5 divide-y divide-line">
  {rows.map(({ label, value, icon, datetime, href }) => (
    <div class="py-3 first:pt-0 last:pb-0">
      <dt class="meta flex items-center gap-1.5 font-bold">
        <Icon name={icon} aria-hidden="true" class="size-4 shrink-0" />
        {label}
      </dt>
      <dd class="mt-1">
        {href ? (
          <a href={href} class="inline-flex min-h-(--spacing-target) items-center">
            {value}
          </a>
        ) : datetime ? (
          <time datetime={datetime}>{value}</time>
        ) : (
          value
        )}
      </dd>
    </div>
  ))}
</dl>
