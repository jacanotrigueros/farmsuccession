---
/** Practical entry points come first; documentary background is secondary. */
import { Icon } from "astro-icon/components";
import type { Resource } from "../lib/corpus.ts";
import { GOALS, goalOf, type GoalId } from "../lib/goals.ts";
import { ICON, kindIcon } from "../lib/icons.ts";
import { kindBlurb, kindLabel } from "../lib/vocabulary.ts";
import { counted, situation, words } from "../lib/words.ts";

type Props = {
  resources: readonly Resource[];
  language: string;
  hrefFor: (goal: GoalId) => string;
  compact?: boolean;
  hrefForKind: (kind: Resource["kind"]) => string;
};
const { resources, language, hrefFor, hrefForKind, compact = false } = Astro.props;
const text = words(language);

const goals = GOALS.filter((goal) => goal.id !== "context").map((goal) => ({
  href: hrefFor(goal.id),
  ...situation(goal.id, language),
  icon: kindIcon(goal.kinds[0]),
  found: resources.filter((resource) => goalOf(resource.kind) === goal.id).length,
}));

/** Advice is a next step in its own right, not background policy information. */
const topics = [
  ...goals,
  {
    href: hrefForKind("ADVICE"),
    title: text.adviceEntry,
    hint: kindBlurb("ADVICE", language),
    icon: kindIcon("ADVICE"),
    found: resources.filter((resource) => resource.kind === "ADVICE").length,
  },
];

/** Everything that is context rather than an answer, counted by kind and in the order the data gives. */
const last = (kind: Resource["kind"]) => (kind === "OTHER" ? 1 : 0);
const others = [
  ...new Set(
    resources.filter((resource) => goalOf(resource.kind) === "context" && resource.kind !== "ADVICE").map((resource) => resource.kind),
  ),
]
  .map((kind) => ({ kind, count: resources.filter((resource) => resource.kind === kind).length }))
  .toSorted((a, b) => last(a.kind) - last(b.kind) || b.count - a.count);
---

<h2 id="needs" class="flex scroll-mt-6 items-center gap-3 text-2xl font-bold">
  <Icon name={ICON.found} aria-hidden="true" class="size-6 shrink-0 text-brand" />
  {text.whatDoYouNeed}
</h2>
<p class="mt-2 max-w-3xl text-muted">{text.needsLead}</p>

<ul class="mt-6 grid gap-4 sm:grid-cols-2 xl:grid-cols-3">
  {topics.map((goal) => (
    <li
      class:list={[
        "card relative flex min-h-full items-start gap-3 border-t-4 border-t-accent-line",
        compact ? "p-4" : "p-5",
        goal.found > 0 && "card-link",
      ]}
    >
      <span class="inline-flex size-10 shrink-0 items-center justify-center rounded-lg bg-accent-tint text-accent">
        <Icon name={goal.icon} aria-hidden="true" class="size-6" />
      </span>
      <div class="min-w-0 flex-1">
        {goal.found > 0 ? (
          <a href={goal.href} class="font-bold text-ink no-underline after:absolute after:inset-0 hover:underline">
            {goal.title}
          </a>
        ) : (
          <span class="font-bold text-ink">{goal.title}</span>
        )}
        {!compact && <p class="meta mt-1">{goal.hint}</p>}
        <p class:list={["mt-2 text-meta font-bold tabular-nums", goal.found > 0 ? "text-brand" : "text-muted"]}>
          {goal.found > 0 ? counted(goal.found, text.record, language) : text.noResourcesDocumented}
        </p>
      </div>
      {goal.found > 0 && <Icon name={ICON.chevron} aria-hidden="true" class="mt-1 size-5 shrink-0 text-muted" />}
    </li>
  ))}
</ul>

{others.length > 0 && (
  <div class:list={[compact ? "mt-6 p-4" : "mt-10 p-5 sm:p-6", "rounded-xl border border-line bg-page"]}>
    <h3 class="text-lg font-bold text-muted">{text.kindsTitle}</h3>
    <ul class="mt-3 grid gap-x-6 sm:grid-cols-2 lg:grid-cols-4">
      {others.map(({ kind, count }) => (
        <li class="relative flex items-start gap-2 border-t border-line py-3" data-kind={kind}>
          <Icon name={kindIcon(kind)} aria-hidden="true" class="mt-1 size-5 shrink-0 text-muted" />
          <div class="min-w-0 flex-1">
            <p class="flex flex-wrap items-baseline justify-between gap-x-2">
              <a href={hrefForKind(kind)} class="text-control font-bold text-ink no-underline after:absolute after:inset-0 hover:underline">
                {kindLabel(kind, language)}
              </a>
              <span class="meta tabular-nums">{count}</span>
            </p>
            {!compact && <p class="meta mt-1">{kindBlurb(kind, language)}</p>}
          </div>
        </li>
      ))}
    </ul>
  </div>
)}
