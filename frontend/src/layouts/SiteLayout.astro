---
/**
 * Every page of the site. It makes no third-party request and sets no cookie, and the only page that
 * ships a script is the one for searching — which still reads without it. Those are requirements rather
 * than preferences: the reader may be on a phone on a rural connection, and nothing here is worth a byte
 * they did not ask for.
 *
 * The page's language is the language its territory's text is written in, which is data rather than a
 * site-wide setting — the European layer is written in English, Spain's in Spanish.
 */
import "../styles/global.css";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import { words } from "../lib/words.ts";
import { countryTerritories, euTerritory, href, languageOf } from "../lib/corpus.ts";

type Props = {
  title: string;
  description: string;
  language: string;
  /** The page a reader is on, so the header can say so without a page having to tell it twice. */
  current?: string;
  /**
   * A page that is true and useful but that a search engine should not carry a copy of: a region whose
   * list is its country's list, a search page, which is not a document of its own. It stays reachable and
   * its links are followed.
   */
  noindex?: boolean;
  /**
   * The one page with no address of its own. GitHub Pages serves `404.html` for every unknown path, so
   * the address a reader is at is the one they mistyped and never this file's. A canonical would name
   * `/404/`, which this build does not produce, so it and `og:url` would both be claims about a page
   * nobody can open — and a search engine that believed them would offer a reader an apology where it
   * meant to offer an answer.
   */
  canonical?: false;
  /** Only these documents have language versions; country directories describe different things. */
  documentKind?: "about" | "history";
};

const { title, description, language, current, noindex = false, canonical: hasAddress = true, documentKind } = Astro.props;
const canonical = hasAddress ? new URL(Astro.url.pathname, Astro.site).href : undefined;
const socialCard = new URL("/social-card.png", Astro.site).href;
const europe = documentKind ? euTerritory() : undefined;
const versions = documentKind
  ? [...(europe ? [europe] : []), ...countryTerritories()].map((territory) => {
      const language = languageOf(territory);
      const slug = words(language)[documentKind === "about" ? "aboutSlug" : "historySlug"];
      return { language, url: new URL(`${href(territory.layer)}${slug}/`, Astro.site).href };
    })
  : [];
const defaultVersion = versions.find(({ language }) => language === "en");
/** Project pages belong in the navigation of entry pages, not below every record in the catalogue. */
const showProjectNavigation = Astro.url.pathname === "/" || /^\/[a-z]{2}\/$/u.test(Astro.url.pathname);
/**
 * The site's name, said once where a search engine looks for it: a result prints it on its own line, so
 * titles do not have to spend their room repeating it. The home page names the site as a WebSite.
 */
const siteName = words(language).siteName;
const website =
  Astro.url.pathname === "/"
    ? JSON.stringify({
        "@context": "https://schema.org",
        "@type": "WebSite",
        name: siteName,
        url: new URL("/", Astro.site).href,
      }).replaceAll("<", "\\u003c")
    : undefined;
---

<!doctype html>
<html lang={language}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {canonical && <link rel="canonical" href={canonical} />}
    {versions.map(({ language, url }) => (
      <link rel="alternate" hreflang={language} href={url} />
    ))}
    {defaultVersion && <link rel="alternate" hreflang="x-default" href={defaultVersion.url} />}
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {website && <script type="application/ld+json" set:html={website} />}
    <meta property="og:type" content="website" />
    {canonical && <meta property="og:url" content={canonical} />}
    {/*
     * The card a link to this site shows when it is shared. It is first-party and committed like every
     * other asset here, and it is absolute because the service drawing the card is not reading it from
     * this page's own address.
     */}
    <meta property="og:image" content={socialCard} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="FarmSuccession · farmsuccession.eu" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialCard} />
    {/*
     * The SVG scales to any size a browser asks for; the ICO carries 16, 32, 48 and 64 for the ones that
     * will not read it. The two below are for the places that read neither: iOS takes a screenshot of the
     * page without an apple-touch-icon, and Android offers no install without a manifest.
     */}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate icon" href="/favicon.ico" type="image/x-icon" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#f3f5f1" />
  </head>
  <body class="min-h-screen flex flex-col">
    <a
      href="#content"
      class="sr-only focus:not-sr-only focus:absolute focus:z-10 focus:m-3 focus:rounded-sm focus:bg-card focus:px-4 focus:py-3 focus:text-brand-strong"
    >
      {words(language).skip}
    </a>
    <Header current={current} language={language} />
    <main id="content" class="flex-1">
      <slot />
    </main>
    <Footer language={language} current={current} showProjectNavigation={showProjectNavigation} />
  </body>
</html>
