---
/**
 * The shell every page about a territory uses: the tree of territories on one side, the page in the
 * middle, what is on this page on the other.
 *
 * The order in the markup is content, then index, then tree, and the columns are rearranged on a wide
 * screen. That way a phone gets the page it asked for first and the two indexes afterwards, which is also
 * the order a screen reader meets them in.
 */
import PageIndex from "../components/PageIndex.astro";
import TerritoryTree from "../components/TerritoryTree.astro";
import SiteLayout from "./SiteLayout.astro";

type Props = {
  title: string;
  description: string;
  language: string;
  current: string;
  sections: ReadonlyArray<{ id: string; label: string; count?: number }>;
};

const { title, description, language, current, sections } = Astro.props;
---

<SiteLayout title={title} description={description} language={language} current={current}>
  <div class="mx-auto max-w-7xl px-4 sm:px-6">
    <div class="lg:grid lg:grid-cols-[14rem_minmax(0,1fr)_13rem] lg:gap-10">
      <div class="lg:order-2">
        <slot />
      </div>

      <aside class="mt-10 hidden border-t border-line pt-6 lg:order-3 lg:mt-10 lg:block lg:border-0 lg:pt-10">
        <div class="lg:sticky lg:top-6">
          <PageIndex sections={sections} language={language} />
        </div>
      </aside>

      <aside class="mt-10 border-t border-line pt-6 lg:order-1 lg:mt-0 lg:border-0 lg:pt-10">
        <div class="lg:sticky lg:top-6 lg:max-h-[calc(100vh-4rem)] lg:overflow-y-auto">
          <TerritoryTree current={current} language={language} />
        </div>
      </aside>
    </div>
  </div>
</SiteLayout>
