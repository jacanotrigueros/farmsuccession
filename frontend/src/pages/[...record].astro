---
/**
 * One record, with the evidence under it.
 *
 * The band at the top is what a reader needs before deciding whether to read on: what kind of thing it is
 * and whether it is operating, what it is called, where it applies and who runs it, what it offers,
 * whether anybody can apply today, and the two ways out of the page — the official page that runs it, and
 * the evidence underneath that says why any of this is here.
 *
 * Then the page proper, in two columns: what a reader does with it on the left — the application periods,
 * how to get it, who it is for, the published figures, what happened to it this year — and the structured
 * facts beside it, as a panel rather than a section, because they are what the record is rather than
 * something to read in order. The evidence closes the page, full width, never folded away.
 *
 * A record has exactly one page, under the country that recorded it. Every territory that inherits the
 * record links here rather than carrying a copy of the evidence at an address of its own.
 */
import { Icon } from "astro-icon/components";
import ApplyNow from "../components/ApplyNow.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import CallWindows from "../components/CallWindows.astro";
import DraftNotice from "../components/DraftNotice.astro";
import Evidence from "../components/Evidence.astro";
import FactList from "../components/FactList.astro";
import KindTag from "../components/KindTag.astro";
import StatusTag from "../components/StatusTag.astro";
import SourceRef from "../components/SourceRef.astro";
import PageIndex from "../components/PageIndex.astro";
import SiteLayout from "../layouts/SiteLayout.astro";
import {
  currentEdition,
  href,
  isDraft,
  languageOf,
  newsAbout,
  recordHref,
  records,
  territories,
  view,
  leafLayers,
  type RecordedResource,
} from "../lib/corpus.ts";
import { goalOf } from "../lib/goals.ts";
import { ICON } from "../lib/icons.ts";
import { dateIn, listIn } from "../lib/language.ts";
import {
  assetLabel,
  audience,
  channelLabel,
  costLabel,
  formatLabel,
  instrumentLabel,
  kindLabel,
  languageName,
  newsTypeLabel,
  operatorTypeLabel,
  purposeLabel,
  quantity,
  reachLabel,
  sectorLabel,
  stateLabel,
} from "../lib/vocabulary.ts";
import { counted, editionNamed, words } from "../lib/words.ts";

export function getStaticPaths() {
  return records().map(({ resource, territory }: RecordedResource) => ({
    params: { record: recordHref(resource.id, territory).slice(1, -1) },
    props: { resource, territory },
  }));
}

const { resource, territory } = Astro.props;
const language = languageOf(territory);
const text = words(language);

/** Every claim on this page cites one of the record's own sources, so each can be followed by number. */
const sourceNumber = new Map(resource.sources.map((source, index) => [source.url, index + 1]));

const news = newsAbout(resource.id);
const place = territory.layer.level === "EU" ? text.europe : territory.data.officialName;

const facts: Array<{ label: string; value: string; datetime?: string }> = [
  { label: text.whatItIsRow, value: kindLabel(resource.kind, language) },
  { label: text.stateRow, value: stateLabel(resource.status, language) },
  { label: text.runByRow, value: resource.operator },
  { label: text.bodyTypeRow, value: operatorTypeLabel(resource.operatorType, language) },
  {
    label: text.reachRow,
    value: resource.scope.area
      ? `${reachLabel(resource.scope.level, language)} — ${resource.scope.area}`
      : reachLabel(resource.scope.level, language),
  },
  ...(resource.accessCostType ? [{ label: text.costRow, value: costLabel(resource.accessCostType, language) }] : []),
  ...(resource.instrumentType ? [{ label: text.supportTypeRow, value: instrumentLabel(resource.instrumentType, language) }] : []),
  ...(resource.purposes
    ? [
        {
          label: text.paysForRow,
          value: listIn(
            resource.purposes.map((purpose) => purposeLabel(purpose, language)),
            language,
          ),
        },
      ]
    : []),
  ...(resource.assetTypes
    ? [
        {
          label: text.handlesRow,
          value: listIn(
            resource.assetTypes.map((asset) => assetLabel(asset, language)),
            language,
          ),
        },
      ]
    : []),
  ...(resource.sectors
    ? [
        {
          label: text.coversRow,
          value: listIn(
            resource.sectors.map((sector) => sectorLabel(sector, language)),
            language,
          ),
        },
      ]
    : []),
  ...(resource.trainingFormats
    ? [
        {
          label: text.taughtRow,
          value: listIn(
            resource.trainingFormats.map((format) => formatLabel(format, language)),
            language,
          ),
        },
      ]
    : []),
  ...(resource.qualifiesForEstablishmentAid === undefined
    ? []
    : [{ label: text.qualifiesRow, value: resource.qualifiesForEstablishmentAid ? text.yes : text.no }]),
  ...(resource.targetProfiles ? [{ label: text.forRow, value: audience(resource.targetProfiles, language) }] : []),
  ...(resource.languages
    ? [
        {
          label: text.availableInRow,
          value: listIn(
            resource.languages.map((code) => languageName(code, language)),
            language,
          ),
        },
      ]
    : []),
  ...(resource.lastEvidenceDate
    ? [{ label: text.latestPageDateRow, value: dateIn(resource.lastEvidenceDate, language), datetime: resource.lastEvidenceDate }]
    : []),
];

const sections = [
  ...(resource.calls && resource.calls.length > 0 ? [{ id: "dates", label: text.periodsTitle, count: resource.calls.length }] : []),
  { id: "access", label: text.accessTitle },
  ...(resource.whoCanUseIt ? [{ id: "who", label: text.whoTitle }] : []),
  { id: "facts", label: text.factsTitle, count: facts.length },
  ...(resource.metrics ? [{ id: "figures", label: text.figuresTitle, count: resource.metrics.length }] : []),
  ...(news.length > 0 ? [{ id: "news", label: text.newsTitle, count: news.length }] : []),
  ...(resource.notes ? [{ id: "notes", label: text.notesTitle }] : []),
  { id: "evidence", label: text.evidenceTitle, count: resource.sources.length },
];

const trail = view(territory).layers;

/** The country the record belongs to, and every region it reaches — the two things a search filters by. */
const country = territory.layer.level === "EU" ? "" : territory.layer.country;
const reaches = leafLayers(territory.layer, territories)
  .map((leaf) => (leaf.level === "REGION" ? `${leaf.country}/${leaf.region}` : ""))
  .filter(Boolean);
---

<SiteLayout
  title={`${resource.name} — ${place} — ${text.siteName}`}
  description={resource.whatItOffers}
  language={language}
  current={href(territory.layer)}
>
  {/*
   * This page is the unit the search index is built from, and the only one: the territory pages list the
   * same records, and indexing them too would return a reader the same record several times over, once
   * per territory that inherits it. `data-pagefind-body` here is what declares that.
   *
   * The filters are what keep a search from widening, and every one of them is a code from the schema
   * rather than a translated word: a shared link has to survive being opened in another language. The
   * country is the layer the record belongs to, and the territories are every region it reaches, so
   * choosing a region returns exactly what that region's own page lists — its own records and the ones it
   * inherits — and never a neighbour's.
   */}
  <div
    data-pagefind-body
    data-pagefind-meta="territory[data-territory]"
    data-territory={territory.layer.level === "EU" ? text.europe : territory.data.officialName}
  >
    <span hidden data-pagefind-filter={`country:${country || "EU"}`} data-pagefind-meta={`country:${country || "EU"}`}></span>
    <span hidden data-pagefind-filter={`kind:${resource.kind}`} data-pagefind-meta={`kind:${resource.kind}`}></span>
    <span hidden data-pagefind-filter={`status:${resource.status}`} data-pagefind-meta={`status:${resource.status}`}></span>
    <span hidden data-pagefind-filter={`scope:${resource.scope.level}`}></span>
    {(resource.targetProfiles ?? []).map((profile) => (
      <span hidden data-pagefind-filter={`profile:${profile}`} />
    ))}
    {reaches.map((leaf) => (
      <span hidden data-pagefind-filter={`territory:${leaf}`} />
    ))}

    <header class="border-b border-line bg-card" data-kind={resource.kind} data-status={resource.status}>
      <div class="wrap py-10">
        <Breadcrumbs
          items={trail.map((above) => ({
            label: above.layer.level === "EU" ? text.europe : above.data.officialName,
            href: href(above.layer),
          }))}
          current={resource.name}
          showCurrent={false}
          label={text.whereYouAre}
        />
        {/* The tags carry this page's own words; the index carries the codes, in the hidden spans above,
          so a result can be described in the language of whichever page found it. */}
        <p class="mt-3 flex flex-wrap items-center gap-x-3 gap-y-2">
          <span data-pagefind-filter={`situation:${goalOf(resource.kind)}`}>
            <KindTag kind={resource.kind} language={language} />
          </span>
          <span>
            <StatusTag status={resource.status} language={language} />
          </span>
        </p>
        <h1 class="page-title mt-4 text-3xl text-balance sm:text-4xl" data-pagefind-meta="title">
          {resource.name}
        </h1>
        <p class="mt-4 flex flex-wrap items-start gap-x-5 gap-y-2 text-muted">
          <span class="inline-flex min-w-0 items-start gap-1.5">
            <Icon name={ICON.territory} aria-hidden="true" class="mt-0.5 size-5 shrink-0" />
            <span>{place}</span>
          </span>
          <span class="inline-flex min-w-0 items-start gap-1.5" data-pagefind-meta="operator">
            <Icon name={ICON.operator} aria-hidden="true" class="mt-0.5 size-5 shrink-0" />
            <span>{resource.operator}</span>
          </span>
        </p>
        <h2 class="eyebrow mt-8">{text.offersTitle}</h2>
        <p class="mt-2 max-w-3xl text-lg" data-pagefind-meta="summary">
          {resource.whatItOffers}
        </p>
        {isDraft(territory) && (
          <div class="mt-5" data-pagefind-ignore>
            <DraftNotice language={language} />
          </div>
        )}
        <ApplyNow resource={resource} language={language} />
        <p class="mt-8 flex flex-wrap gap-3" data-pagefind-ignore>
          <a href={resource.accessUrl} rel="noopener" class="btn btn-primary">
            <Icon name={ICON.external} aria-hidden="true" class="size-5 shrink-0" />
            {text.officialPage}
          </a>
          <a href="#evidence" class="btn btn-quiet">
            <Icon name={ICON.evidence} aria-hidden="true" class="size-5 shrink-0" />
            {text.evidenceTitle} · {counted(resource.sources.length, text.source)}
          </a>
        </p>
      </div>
    </header>

    <PageIndex sections={sections} language={language} />

    <div class="wrap grid gap-10 py-12 lg:grid-cols-[minmax(0,1fr)_20rem]">
      <div class="grid content-start gap-10">
        {resource.calls && resource.calls.length > 0 && (
          <section aria-labelledby="dates">
            <h2 id="dates" class="scroll-mt-6 text-2xl font-bold">
              {text.periodsTitle}
            </h2>
            <div class="mt-4">
              <CallWindows calls={resource.calls} sources={resource.sources} language={language} />
            </div>
          </section>
        )}

        <section aria-labelledby="access">
          <h2 id="access" class="scroll-mt-6 text-2xl font-bold">
            {text.accessTitle}
          </h2>
          {resource.howToAccess && <p class="mt-3 max-w-3xl">{resource.howToAccess}</p>}
          {resource.contactPoints && (
            <>
              <h3 class="mt-8 text-lg font-bold">{text.contactTitle}</h3>
              <ul class="mt-2">
                {resource.contactPoints.map((contact) => {
                  const cited = sourceNumber.get(contact.sourceUrl);
                  return (
                    <li class="border-t border-line py-2">
                      <span class="text-meta text-muted">
                        {channelLabel(contact.channel, language)} · {contact.label}
                      </span>
                      <p class="flex min-h-(--spacing-target) flex-wrap items-center gap-x-2">
                        {contact.channel === "EMAIL" && (
                          <a href={`mailto:${contact.value}`} class="break-words">
                            {contact.value}
                          </a>
                        )}
                        {contact.channel === "PHONE" && <a href={`tel:${contact.value.replace(/\s/gu, "")}`}>{contact.value}</a>}
                        {contact.channel === "FORM" && (
                          <a href={contact.value} rel="noopener" class="break-words">
                            {contact.value}
                          </a>
                        )}
                        {contact.channel === "OFFICE" && <span>{contact.value}</span>}
                        {cited && <SourceRef number={cited} language={language} />}
                      </p>
                    </li>
                  );
                })}
              </ul>
            </>
          )}
        </section>

        {resource.whoCanUseIt && (
          <section aria-labelledby="who">
            <h2 id="who" class="scroll-mt-6 text-2xl font-bold">
              {text.whoTitle}
            </h2>
            <p class="mt-3 max-w-3xl">{resource.whoCanUseIt}</p>
          </section>
        )}

        {resource.metrics && (
          <section aria-labelledby="figures">
            <h2 id="figures" class="scroll-mt-6 text-2xl font-bold">
              {text.figuresTitle}
            </h2>
            <ul class="mt-4 divide-y divide-line border-y border-line">
              {resource.metrics.map((metric) => {
                const cited = sourceNumber.get(metric.sourceUrl);
                return (
                  <li class="flex flex-col gap-1 py-3 sm:flex-row sm:items-baseline sm:gap-4">
                    <span class="shrink-0 text-lg font-bold text-ink tabular-nums sm:w-44">
                      {quantity(metric.value, metric.unit, language)}
                    </span>
                    <span>
                      {metric.label}
                      <span class="meta block">
                        {text.asOf} <time datetime={metric.asOf}>{dateIn(metric.asOf, language)}</time>{" "}
                        {cited && <SourceRef number={cited} language={language} />}
                      </span>
                    </span>
                  </li>
                );
              })}
            </ul>
          </section>
        )}

        {news.length > 0 && (
          <section aria-labelledby="news">
            <h2 id="news" class="scroll-mt-6 text-2xl font-bold">
              {text.newsTitle}
            </h2>
            <ul class="mt-4 space-y-5">
              {news.map((item) => (
                <li>
                  <p class="text-meta text-muted">
                    <time datetime={item.date}>{dateIn(item.date, language)}</time> · {newsTypeLabel(item.type, language)}
                  </p>
                  <p class="font-semibold">{item.headline}</p>
                  <p class="max-w-3xl">{item.summary}</p>
                  <ul class="mt-1">
                    {item.sources.map((source) => (
                      <li class="text-meta text-muted">
                        <a href={source.url} rel="noopener" class="inline-flex min-h-(--spacing-target) items-center break-words">
                          {source.title}
                        </a>
                        {", "}
                        {text.recordedOn} <time datetime={source.consultedOn}>{dateIn(source.consultedOn, language)}</time>
                      </li>
                    ))}
                  </ul>
                </li>
              ))}
            </ul>
          </section>
        )}

        {resource.notes && (
          <section class="notice" aria-labelledby="notes">
            <Icon name={ICON.note} aria-hidden="true" class="mt-1 size-5 shrink-0 text-accent" />
            <div>
              <h2 id="notes" class="scroll-mt-6 text-xl font-bold">
                {text.notesTitle}
              </h2>
              <p class="mt-2">{resource.notes}</p>
            </div>
          </section>
        )}
      </div>

      {/* The facts are a panel rather than a section: they are what the record is, not a step of reading
        it, and beside the text they stay available while a reader works down the page. */}
      <aside id="facts" aria-labelledby="facts-title" class="card self-start p-6">
        <h2 id="facts-title" class="scroll-mt-6 text-xl font-bold">
          {text.factsTitle}
        </h2>
        <FactList rows={facts} />
      </aside>
    </div>

    <section class="border-t border-line bg-card" aria-labelledby="evidence">
      <div class="wrap py-12">
        <h2 id="evidence" class="flex scroll-mt-6 items-center gap-2 text-2xl font-bold">
          <Icon name={ICON.evidence} aria-hidden="true" class="size-7 shrink-0 text-brand" />
          {text.evidenceTitle}
        </h2>
        <div class="mt-2">
          <Evidence sources={resource.sources} language={language} />
        </div>
        <p class="mt-8 text-meta text-muted">
          {editionNamed(currentEdition, language)} · {text.publishedOn}{" "}
          <time datetime={territory.data.published}>{dateIn(territory.data.published, language)}</time>
        </p>
      </div>
    </section>
  </div>
</SiteLayout>
