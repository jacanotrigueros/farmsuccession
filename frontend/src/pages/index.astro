---
/**
 * Europe: what this is, how to search it, what it holds, and why its data can be trusted — in that order.
 *
 * Every figure on this page is counted from the corpus when the page is built, never written down here.
 * The ones that would be flattering to round are the ones most worth counting: a reader deciding whether
 * to trust an inventory is owed the size of it and how much of it a person has actually checked.
 *
 * It is written in the language of the European layer, because that is the layer it is about.
 */
import { Icon } from "astro-icon/components";
import Needs from "../components/Needs.astro";
import StandaloneNews from "../components/StandaloneNews.astro";
import SearchBox from "../components/SearchBox.astro";
import SiteLayout from "../layouts/SiteLayout.astro";
import {
  corpusStats,
  countryTerritories,
  currentEdition,
  euTerritory,
  href,
  hubTerritories,
  languageOf,
  regionTerritories,
  regionsOf,
} from "../lib/corpus.ts";
import { GOALS } from "../lib/goals.ts";
import { flagOf, ICON } from "../lib/icons.ts";
import { counted, editionNamed, words } from "../lib/words.ts";
import { searchUrl } from "../../public/search-scope.js";

const europe = euTerritory();
if (!europe) {
  throw new Error(`no European layer in edition ${currentEdition}: the home page has nothing to be about`);
}

const language = languageOf(europe);
const text = words(language);
const stats = corpusStats();

/** The flag of a country, as a file: a flag emoji is two letters on any system without a glyph for the pair. */

/**
 * What a country card counts is what applies inside it — its own records, its groupings', its regions'
 * and the European ones — because that is what a reader gets by going there, not what the country file
 * happens to hold.
 */
const countries = countryTerritories().map((country) => {
  const iso = country.layer.level === "EU" ? "" : country.layer.country;
  const inside = [country, ...hubTerritories().filter(({ layer }) => layer.level === "HUB" && layer.country === iso), ...regionsOf(iso)];
  return {
    href: href(country.layer),
    name: country.data.officialName,
    flag: flagOf(iso),
    records: inside.reduce((total, { data }) => total + data.resources.length, 0) + europe.data.resources.length,
    territories: regionsOf(iso).length,
  };
});

/** Everything in the edition, which is what the cards on this page count and link into. */
const everything = [europe, ...countryTerritories(), ...hubTerritories(), ...regionTerritories()].flatMap(({ data }) => data.resources);

const editionNote = (stats.drafts === stats.files ? text.editionAllDrafts : text.editionSomeDrafts)
  .replace("{edition}", currentEdition)
  .replace("{drafts}", String(stats.drafts))
  .replace("{files}", String(stats.files));

const figures = [
  { icon: ICON.resources, value: stats.records, label: counted(stats.records, text.statRecords, language) },
  { icon: ICON.europe, value: stats.countries, label: counted(stats.countries, text.statCountries, language) },
  { icon: ICON.territory, value: stats.territories, label: counted(stats.territories, text.statTerritories, language) },
  { icon: ICON.sources, value: stats.sources, label: counted(stats.sources, text.statSources, language) },
];

const trust = [
  { icon: ICON.evidence, title: text.trustSourced },
  { icon: ICON.checked, title: text.trustDated },
  { icon: ICON.open, title: text.trustOpen },
];
---

<SiteLayout title={`${text.siteName} · ${text.tagline}`} description={text.lead} language={language} current="/">
  <section class="border-b border-line bg-card">
    <div class="wrap py-10 lg:py-14">
      <p class="eyebrow">
        {text.siteName} · {editionNamed(currentEdition, language)}
      </p>
      {stats.news > 0 && (
        <p class="meta mt-1 flex items-center gap-1.5">
          <Icon name={ICON.date} aria-hidden="true" class="size-4 text-brand" />
          {text.newsCount.replace("{n}", String(stats.news)).replace("{edition}", currentEdition)}
        </p>
      )}
      <h1 class="page-title mt-2 max-w-3xl text-3xl text-balance sm:text-4xl">{text.tagline}</h1>
      <p class="mt-4 max-w-3xl text-lg text-muted">{text.lead}</p>

      <div class="mt-8 max-w-3xl">
        <SearchBox
          action={searchUrl("/")}
          id="home-q"
          label={text.searchAcrossEurope}
          button={text.searchAction}
          examples={text.searchExamples}
        />
        <a href={searchUrl("/")} class="mt-4 inline-flex min-h-(--spacing-target) items-center font-bold underline">
          {text.browseAcrossEurope}
        </a>
      </div>

      <div class="mt-10 rounded-lg bg-page p-5">
        <ul class="grid grid-cols-2 gap-4 sm:grid-cols-4" aria-label={text.statsLabel}>
          {figures.map((figure) => (
            <li class="flex items-center gap-3">
              <Icon name={figure.icon} aria-hidden="true" class="size-5 shrink-0 text-brand" />
              <p>
                <span class="block text-2xl font-bold text-brand tabular-nums">{figure.value}</span>
                <span class="meta block">{figure.label.replace(`${figure.value} `, "")}</span>
              </p>
            </li>
          ))}
        </ul>
        <ul class="mt-4 flex flex-wrap items-center gap-x-6 gap-y-2 border-t border-line pt-4 text-meta">
          {trust.map((point) => (
            <li class="flex items-center gap-2 font-bold text-ink">
              <Icon name={point.icon} aria-hidden="true" class="size-4 shrink-0 text-brand" />
              {point.title}
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <section class="border-b border-line" aria-labelledby="countries">
    <div class="wrap py-12">
      <h2 id="countries" class="text-2xl font-bold">
        {text.countriesTitle}
      </h2>
      <p class="meta mt-1">
        {text.countriesLead
          .replace("{territories}", counted(stats.territories, text.statTerritories, language))
          .replace("{countries}", counted(stats.countries, text.statCountries, language))}
      </p>
      <ul class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {countries.map((country) => (
          <li>
            <a href={country.href} class="card card-link flex min-h-full items-center gap-3 p-5 no-underline">
              <img src={country.flag} alt="" width="36" height="27" class="h-7 w-9 shrink-0 rounded-xs border border-line object-cover" />
              <span class="flex min-w-0 flex-1 flex-col">
                <span class="text-lg font-bold text-ink">{country.name}</span>
                <span class="meta">
                  {counted(country.records, text.cardApplicable, language)} · {counted(country.territories, text.statTerritories, language)}
                </span>
              </span>
              <Icon name={ICON.chevron} aria-hidden="true" class="size-5 shrink-0 text-muted" />
            </a>
          </li>
        ))}
      </ul>
      <p class="meta mt-4">{text.euAlso.replace("{n}", String(europe.data.resources.length))}</p>
    </div>
  </section>

  <section class="border-b border-line bg-card" aria-labelledby="needs">
    <div class="wrap py-12">
      <Needs
        resources={everything}
        language={language}
        hrefFor={(goal) => searchUrl("/", { selected: { kind: [...(GOALS.find(({ id }) => id === goal)?.kinds ?? [])] } })}
        hrefForKind={(kind) => searchUrl("/", { selected: { kind: [kind] } })}
      />
    </div>
  </section>

  <StandaloneNews items={europe.data.news} language={language} />

  <div class="wrap py-8">
    <p class="meta flex items-start gap-2">
      <Icon name={ICON.draft} aria-hidden="true" class="mt-0.5 size-4 shrink-0 text-accent" />
      <span>
        {editionNote}{" "}
        <a href={`/${text.aboutSlug}/#method`} class="font-bold underline">
          {text.methodTitle}
        </a>
      </span>
    </p>
  </div>
</SiteLayout>
