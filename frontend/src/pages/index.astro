---
/**
 * Europe: what this is, how to search it, what it holds, and why its data can be trusted — in that order.
 *
 * Every figure on this page is counted from the corpus when the page is built, never written down here.
 * The ones that would be flattering to round are the ones most worth counting: a reader deciding whether
 * to trust an inventory is owed the size of it and how much of it a person has actually checked.
 *
 * It is written in the language of the European layer, because that is the layer it is about.
 */
import { Icon } from "astro-icon/components";
import CountryCards from "../components/CountryCards.astro";
import Needs from "../components/Needs.astro";
import StandaloneNews from "../components/StandaloneNews.astro";
import SearchBox from "../components/SearchBox.astro";
import SiteLayout from "../layouts/SiteLayout.astro";
import {
  corpusStats,
  countryTerritories,
  currentEdition,
  euTerritory,
  EUROPE_PAGE,
  hubTerritories,
  languageOf,
  regionTerritories,
} from "../lib/corpus.ts";
import { GOALS } from "../lib/goals.ts";
import { ICON } from "../lib/icons.ts";
import { formIndex, numberIn } from "../../public/locale.js";
import { words } from "../lib/words.ts";
import { searchUrl } from "../../public/search-scope.js";

const europe = euTerritory();
if (!europe) {
  throw new Error(`no European layer in edition ${currentEdition}: the home page has nothing to be about`);
}

const language = languageOf(europe);
const text = words(language);
const stats = corpusStats();

/** Everything in the edition, which is what the cards on this page count and link into. */
const everything = [europe, ...countryTerritories(), ...hubTerritories(), ...regionTerritories()].flatMap(({ data }) => data.resources);

/**
 * The directory's size, one row under the country heading, each figure with its icon. The
 * source-and-date promise and the licence are not repeated here: every page's footer says them.
 */
// The figure is printed once, in the reader's number format, and the label carries only its words:
// "1,103" over "sources cited", never "1103" over "1,103 sources cited".
const figure = (icon: string, value: number, forms: readonly string[]) => ({
  icon,
  value: numberIn(value, language),
  label: forms[formIndex(value, language, forms.length)],
});
const figures = [
  figure(ICON.resources, stats.records, text.statRecords),
  figure(ICON.europe, stats.countries, text.statCountries),
  figure(ICON.territory, stats.territories, text.statTerritories),
  figure(ICON.sources, stats.sources, text.statSources),
];
---

<SiteLayout title={`${text.tagline} · ${text.siteName}`} description={text.lead} language={language} current="/">
  <section class="border-b border-line bg-card">
    <div class="wrap py-10 lg:py-14">
      {/* The header already names the site, so the hero opens with what a reader can do, not the name
          again. The page title and description keep the searchable tagline and lead. */}
      {stats.news > 0 && (
        <p class="meta flex items-center gap-1.5">
          <Icon name={ICON.date} aria-hidden="true" class="size-4 text-brand" />
          {text.newsCount.replace("{n}", String(stats.news)).replace("{edition}", currentEdition)}
        </p>
      )}
      <h1 class="page-title mt-2 max-w-3xl text-3xl text-balance sm:text-4xl">{text.heroTitle}</h1>
      <p class="mt-4 text-lg text-muted">{text.heroLead}</p>

      <div class="mt-8 max-w-3xl">
        <SearchBox
          action={searchUrl("/")}
          id="home-q"
          label={text.searchAcrossEurope}
          button={text.searchAction}
          examples={text.searchExamples}
        />
        <a class="mt-4 inline-flex min-h-(--spacing-target) items-center font-bold underline" href={`${EUROPE_PAGE}#own`}>
          {text.browseEurope}
        </a>
      </div>
    </div>
  </section>

  <section class="border-b border-line" aria-labelledby="countries">
    <div class="wrap py-12">
      <h2 id="countries" class="text-2xl font-bold">
        {text.chooseCountry}
      </h2>
      {/* The figures share the cards' columns, so each figure sits over a column of countries and its icon
          lines up with the flags inside the cards (the cards' own padding). */}
      <ul class="mt-4 grid grid-cols-2 gap-4 lg:grid-cols-4" aria-label={text.statsLabel}>
        {figures.map((figure) => (
          <li class="flex min-w-0 items-start gap-3 sm:px-5">
            <Icon name={figure.icon} aria-hidden="true" class="mt-1 size-5 shrink-0 text-brand" />
            <p class="min-w-0">
              <span class="block text-2xl leading-tight font-bold text-brand tabular-nums">{figure.value}</span>
              <span class="meta block">{figure.label}</span>
            </p>
          </li>
        ))}
      </ul>
      <CountryCards language={language} />
    </div>
  </section>

  <section class="border-b border-line bg-card" aria-labelledby="needs">
    <div class="wrap py-10">
      <Needs
        resources={everything}
        language={language}
        hrefFor={(goal) => searchUrl("/", { selected: { kind: [...(GOALS.find(({ id }) => id === goal)?.kinds ?? [])] } })}
        hrefForKind={(kind) => searchUrl("/", { selected: { kind: [kind] } })}
      />
    </div>
  </section>

  <StandaloneNews items={europe.data.news} language={language} />
</SiteLayout>
