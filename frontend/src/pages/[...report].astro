---
/** One public intake, with a preselected reason and context from the page that led here. */
import { reportEndpoint } from "../../reporting.config.mjs";
import PageHeader from "../components/PageHeader.astro";
import ReportDelivery from "../components/ReportDelivery.astro";
import SiteLayout from "../layouts/SiteLayout.astro";
import { countryTerritories, euTerritory, href, languageOf, type Territory } from "../lib/corpus.ts";
import { words } from "../lib/words.ts";

export function getStaticPaths() {
  const europe = euTerritory();
  const everywhere: Territory[] = [...(europe ? [europe] : []), ...countryTerritories()];
  return everywhere.map((territory) => {
    const language = languageOf(territory);
    const where = territory.layer.level === "EU" ? "" : `${territory.layer.country.toLowerCase()}/`;
    return { params: { report: `${where}${words(language).reportSlug}` }, props: { territory } };
  });
}

const { territory } = Astro.props;
const language = languageOf(territory);
const text = words(language);
const home = href(territory.layer);
const fieldClass =
  "mt-2 min-h-(--spacing-target) min-w-0 w-full rounded-lg border-2 border-line-strong bg-card px-3 py-2 focus:border-brand";
---

<SiteLayout title={`${text.reportTitle} · ${text.siteName}`} description={text.reportIntro} language={language} current={home} noindex>
  <PageHeader
    crumbs={[{ label: territory.layer.level === "EU" ? text.europe : territory.data.officialName, href: home }]}
    crumbsLabel={text.whereYouAre}
    title={text.reportTitle}
    lead={text.reportIntro}
  />
  <div class="wrap py-10">
    <div class="grid min-w-0 max-w-3xl gap-6">
      <aside class="notice" aria-label={text.reportVerification}>
        <div>
          <p class="font-bold">{text.reportVerification}</p>
          <p class="mt-1">{text.reportNoPapers}</p>
        </div>
      </aside>
      <div data-report-context class="card hidden p-5" aria-labelledby="report-context-title">
        <h2 id="report-context-title" class="text-lg font-bold">
          {text.reportContextLabel}
        </h2>
        <dl class="mt-3 grid gap-2">
          {[
            ["territory", text.reportTerritoryLabel],
            ["record", text.reportRecordLabel],
            ["from", text.reportFromLabel],
          ].map(([key, label]) => (
            <div data-context-row={key} hidden>
              <dt class="font-bold">{label}</dt>
              <dd class="break-words" data-context-value={key}></dd>
            </div>
          ))}
        </dl>
      </div>
      <form
        class="grid min-w-0 gap-5"
        data-report
        data-kind="missing"
        data-subject={text.reportMailSubject}
        action={reportEndpoint || "mailto:contact@farmsuccession.eu"}
        data-report-transport={reportEndpoint ? "post" : "email"}
        method="post"
        enctype={reportEndpoint ? "application/x-www-form-urlencoded" : "text/plain"}
      >
        {[
          ["territory", text.reportTerritoryLabel],
          ["record", text.reportRecordLabel],
          ["from", text.reportFromLabel],
        ].map(([key, label]) => (
          <input type="hidden" name={key} data-context-input={key} data-mail-label={label} />
        ))}
        <div class="min-w-0">
          <label for="report-kind" class="block font-bold">
            {text.reportReasonLabel}
          </label>
          <select id="report-kind" name="kind" data-report-kind required data-mail-label={text.reportReasonLabel} class={fieldClass}>
            {[
              ["missing", text.reportMissingTitle, text.reportMailSubjectMissing],
              ["correction", text.reportCorrectionTitle, text.reportMailSubjectCorrection],
              ["looking", text.reportLookingTitle, text.reportMailSubjectLooking],
              ["feedback", text.reportFeedbackTitle, text.reportMailSubjectFeedback],
              ["removal", text.reportRemovalAction, text.reportMailSubjectRemoval],
            ].map(([kind, label, subject]) => (
              <option
                value={kind}
                data-subject={subject}
                data-detail-label={kind === "feedback" ? text.reportFeedbackLabel : text.reportDetailLabel}
                data-detail-hint={kind === "feedback" ? text.reportFeedbackHint : text.reportDetailHint}
              >
                {label}
              </option>
            ))}
          </select>
        </div>
        <div data-report-only="correction">
          <label for="report-issue" class="block font-bold">
            {text.reportIssueLabel}
          </label>
          <select id="report-issue" name="issue" data-mail-label={text.reportIssueLabel} class={fieldClass}>
            <option value="changed">{text.reportIssueChanged}</option>
            <option value="broken">{text.reportIssueBroken}</option>
            <option value="gone">{text.reportIssueGone}</option>
            <option value="missing">{text.reportIssueMissing}</option>
            <option value="other">{text.reportIssueOther}</option>
          </select>
        </div>
        <div>
          <label for="report-source" class="block font-bold">
            {text.reportPublicPageLabel}
          </label>
          <p id="report-source-hint" class="meta mt-1">
            {text.reportPublicPageHint}
          </p>
          <input
            id="report-source"
            name="source"
            type="url"
            inputmode="url"
            data-report-source
            aria-describedby="report-source-hint"
            data-mail-label={text.reportPublicPageLabel}
            class={fieldClass}
          />
        </div>
        <div>
          <label for="report-detail" data-report-detail-label class="block font-bold">
            {text.reportDetailLabel}
          </label>
          <p id="report-detail-hint" data-report-detail-hint class="meta mt-1">
            {text.reportDetailHint}
          </p>
          <textarea
            id="report-detail"
            name="detail"
            rows="4"
            required
            data-prefill="looking"
            aria-describedby="report-detail-hint"
            data-mail-label={text.reportDetailLabel}
            class={fieldClass}
          ></textarea>
        </div>
        <div data-report-only="looking">
          <label for="report-where" class="block font-bold">
            {text.reportLookingWhereLabel}
          </label>
          <p id="report-where-hint" class="meta mt-1">
            {text.reportLookingWhereHint}
          </p>
          <input
            id="report-where"
            name="where"
            type="text"
            aria-describedby="report-where-hint"
            data-mail-label={text.reportLookingWhereLabel}
            class={fieldClass}
          />
        </div>
        <p data-removal-review class="font-bold">
          {text.reportRemovalVerification}
        </p>
        <ReportDelivery language={language} kind="report" subject={text.reportMailSubject} />
      </form>
    </div>
  </div>
  <script is:inline type="module" src="/report.js" defer />
</SiteLayout>
