---
/**
 * Public intake for knowledge the directory has missed or that has changed.
 *
 * This stays on the same side of the project's boundary as the About page: a reader can tell the
 * maintainer what to investigate, but nothing they type becomes data. GitHub remains an editorial tool
 * behind the site, never a prerequisite for somebody who knows a territory better than this inventory.
 *
 * GitHub Pages has no server and the site deliberately makes no third-party request. The form therefore
 * prepares an ordinary email in the reader's mail client. A tiny first-party script adds the context from
 * the page that sent them here and writes a readable subject/body; without it the form still targets the
 * same mailbox and the address is printed beside it.
 */
import PageHeader from "../components/PageHeader.astro";
import SiteLayout from "../layouts/SiteLayout.astro";
import { countryTerritories, euTerritory, href, languageOf, type Territory } from "../lib/corpus.ts";
import { words } from "../lib/words.ts";

export function getStaticPaths() {
  const europe = euTerritory();
  const everywhere: Territory[] = [...(europe ? [europe] : []), ...countryTerritories()];
  return everywhere.map((territory) => {
    const language = languageOf(territory);
    const where = territory.layer.level === "EU" ? "" : `${territory.layer.country.toLowerCase()}/`;
    return { params: { report: `${where}${words(language).reportSlug}` }, props: { territory } };
  });
}

const { territory } = Astro.props;
const language = languageOf(territory);
const text = words(language);
const home = href(territory.layer);
---

<SiteLayout title={`${text.reportTitle} · ${text.siteName}`} description={text.reportIntro} language={language} current={home} noindex>
  <PageHeader
    crumbs={[{ label: territory.layer.level === "EU" ? text.europe : territory.data.officialName, href: home }]}
    crumbsLabel={text.whereYouAre}
    title={text.reportTitle}
    lead={text.reportIntro}
  />

  <div class="wrap py-10">
    <div class="grid max-w-3xl gap-10">
      <aside class="notice" aria-label={text.reportVerification}>
        <div>
          <p class="font-bold">{text.reportVerification}</p>
          <p class="mt-1">{text.reportNoPapers}</p>
        </div>
      </aside>

      <div data-report-context class="card hidden p-5" aria-labelledby="report-context-title">
        <h2 id="report-context-title" class="text-lg font-bold">
          {text.reportContextLabel}
        </h2>
        <dl class="mt-3 grid gap-2">
          <div data-context-row="territory" hidden>
            <dt class="font-bold">{text.reportTerritoryLabel}</dt>
            <dd data-context-value="territory"></dd>
          </div>
          <div data-context-row="record" hidden>
            <dt class="font-bold">{text.reportRecordLabel}</dt>
            <dd data-context-value="record"></dd>
          </div>
          <div data-context-row="from" hidden>
            <dt class="font-bold">{text.reportFromLabel}</dt>
            <dd class="break-words" data-context-value="from"></dd>
          </div>
        </dl>
      </div>

      <section id="missing" data-report-section="missing" aria-labelledby="missing-title">
        <h2 id="missing-title" class="text-2xl font-bold">
          {text.reportMissingTitle}
        </h2>
        <p class="mt-2">{text.reportMissingLead}</p>

        <form
          class="mt-6 grid gap-5"
          data-report
          data-kind="missing"
          data-subject={text.reportMailSubjectMissing}
          action="mailto:contact@farmsuccession.eu"
          method="post"
          enctype="text/plain"
        >
          <input type="hidden" name="territory" data-context-input="territory" data-mail-label={text.reportTerritoryLabel} />
          <input type="hidden" name="from" data-context-input="from" data-mail-label={text.reportFromLabel} />

          <div>
            <label for="missing-source" class="block font-bold">
              {text.reportSourceLabel}
            </label>
            <p id="missing-source-hint" class="meta mt-1">
              {text.reportSourceHint}
            </p>
            <input
              id="missing-source"
              name="source"
              type="url"
              inputmode="url"
              required
              aria-describedby="missing-source-hint"
              data-mail-label={text.reportSourceLabel}
              class="mt-2 min-h-(--spacing-target) w-full rounded-lg border-2 border-line-strong bg-card px-3 py-2 focus:border-brand"
            />
          </div>

          <div>
            <label for="missing-name" class="block font-bold">
              {text.reportNameLabel}
            </label>
            <p id="missing-name-hint" class="meta mt-1">
              {text.reportNameHint}
            </p>
            <input
              id="missing-name"
              name="name"
              type="text"
              aria-describedby="missing-name-hint"
              data-mail-label={text.reportNameLabel}
              class="mt-2 min-h-(--spacing-target) w-full rounded-lg border-2 border-line-strong bg-card px-3 py-2 focus:border-brand"
            />
          </div>

          <div>
            <label for="missing-detail" class="block font-bold">
              {text.reportDetailLabel}
            </label>
            <p id="missing-detail-hint" class="meta mt-1">
              {text.reportDetailHint}
            </p>
            <textarea
              id="missing-detail"
              name="detail"
              rows="4"
              required
              aria-describedby="missing-detail-hint"
              data-mail-label={text.reportDetailLabel}
              class="mt-2 w-full rounded-lg border-2 border-line-strong bg-card px-3 py-2 focus:border-brand"
            ></textarea>
          </div>

          <div class="flex flex-wrap items-center gap-4">
            <button type="submit" class="btn btn-primary">
              {text.reportPrepare}
            </button>
            <a class="inline-flex min-h-(--spacing-target) items-center underline" href="mailto:contact@farmsuccession.eu">
              contact@farmsuccession.eu
            </a>
          </div>
          <p class="meta">{text.reportEmailFallback}</p>
        </form>
      </section>

      <section id="correction" data-report-section="correction" class="border-t border-line pt-10" aria-labelledby="correction-title">
        <h2 id="correction-title" class="text-2xl font-bold">
          {text.reportCorrectionTitle}
        </h2>
        <p class="mt-2">{text.reportCorrectionLead}</p>

        <form
          class="mt-6 grid gap-5"
          data-report
          data-kind="correction"
          data-subject={text.reportMailSubjectCorrection}
          action="mailto:contact@farmsuccession.eu"
          method="post"
          enctype="text/plain"
        >
          <input type="hidden" name="territory" data-context-input="territory" data-mail-label={text.reportTerritoryLabel} />
          <input type="hidden" name="record" data-context-input="record" data-mail-label={text.reportRecordLabel} />
          <input type="hidden" name="from" data-context-input="from" data-mail-label={text.reportFromLabel} />

          <div>
            <label for="correction-kind" class="block font-bold">
              {text.reportIssueLabel}
            </label>
            <select
              id="correction-kind"
              name="issue"
              required
              data-mail-label={text.reportIssueLabel}
              class="mt-2 min-h-(--spacing-target) w-full rounded-lg border-2 border-line-strong bg-card px-3 py-2 focus:border-brand"
            >
              <option value="changed">{text.reportIssueChanged}</option>
              <option value="broken">{text.reportIssueBroken}</option>
              <option value="gone">{text.reportIssueGone}</option>
              <option value="missing">{text.reportIssueMissing}</option>
              <option value="other">{text.reportIssueOther}</option>
            </select>
          </div>

          <div>
            <label for="correction-detail" class="block font-bold">
              {text.reportDetailLabel}
            </label>
            <p id="correction-detail-hint" class="meta mt-1">
              {text.reportDetailHint}
            </p>
            <textarea
              id="correction-detail"
              name="detail"
              rows="4"
              required
              aria-describedby="correction-detail-hint"
              data-mail-label={text.reportDetailLabel}
              class="mt-2 w-full rounded-lg border-2 border-line-strong bg-card px-3 py-2 focus:border-brand"
            ></textarea>
          </div>

          <div>
            <label for="correction-source" class="block font-bold">
              {text.reportNewSourceLabel}
            </label>
            <p id="correction-source-hint" class="meta mt-1">
              {text.reportNewSourceHint}
            </p>
            <input
              id="correction-source"
              name="source"
              type="url"
              inputmode="url"
              aria-describedby="correction-source-hint"
              data-mail-label={text.reportNewSourceLabel}
              class="mt-2 min-h-(--spacing-target) w-full rounded-lg border-2 border-line-strong bg-card px-3 py-2 focus:border-brand"
            />
          </div>

          <div class="flex flex-wrap items-center gap-4">
            <button type="submit" class="btn btn-primary">
              {text.reportPrepare}
            </button>
            <a class="inline-flex min-h-(--spacing-target) items-center underline" href="mailto:contact@farmsuccession.eu">
              contact@farmsuccession.eu
            </a>
          </div>
          <p class="meta">{text.reportEmailFallback}</p>
        </form>
      </section>
    </div>
  </div>

  <script is:inline type="module" src="/report.js" defer />
</SiteLayout>
