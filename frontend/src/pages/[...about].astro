---
/**
 * What this project is, how it is made, and what it does not do — one page per language, at the word that
 * language uses for it: `/about/` and `/es/proyecto/`.
 *
 * It exists because an inventory asks a reader to trust it, and the things that decide whether that trust
 * is warranted are not on any record: who maintains it, where the facts come from, what the checks do and
 * do not establish, what happens to a message you send, and who owns the words. A reader looking for any
 * of those is looking for one page, so it is one page with named sections rather than five.
 */
import OnThisPage from "../components/OnThisPage.astro";
import PageHeader from "../components/PageHeader.astro";
import SiteLayout from "../layouts/SiteLayout.astro";
import { countryTerritories, euTerritory, href, languageOf, type Territory } from "../lib/corpus.ts";
import { words } from "../lib/words.ts";

export function getStaticPaths() {
  const europe = euTerritory();
  const everywhere: Territory[] = [...(europe ? [europe] : []), ...countryTerritories()];
  return everywhere.map((territory) => {
    const language = languageOf(territory);
    const where = territory.layer.level === "EU" ? "" : `${territory.layer.country.toLowerCase()}/`;
    return { params: { about: `${where}${words(language).aboutSlug}` }, props: { territory } };
  });
}

const { territory } = Astro.props;
const language = languageOf(territory);
const text = words(language);
const home = href(territory.layer);

const sections = [
  { id: "overview", label: text.overviewTitle },
  { id: "method", label: text.methodTitle },
  { id: "history-2016", label: text.historySection },
  { id: "contact", label: text.contactTitle2 },
  { id: "privacy", label: text.privacyTitle },
  { id: "licence", label: text.licenceTitle },
];

/** The history page of this language, which the section about the domain's own past leads to. */
const historyPath = territory.layer.level === "EU" ? `/${text.historySlug}/` : `${home}${text.historySlug}/`;
---

<SiteLayout title={`${text.aboutTitle} · ${text.siteName}`} description={text.aboutIntro} language={language} current={home}>
  <PageHeader
    crumbs={[{ label: territory.layer.level === "EU" ? text.europe : territory.data.officialName, href: home }]}
    crumbsLabel={text.whereYouAre}
    title={text.aboutTitle}
    lead={text.aboutIntro}
  >
    <p class="mt-3 max-w-3xl font-bold">{text.notOfficial}</p>
  </PageHeader>

  <div class="wrap grid gap-10 py-10 lg:grid-cols-[minmax(0,1fr)_18rem]">
    <div class="grid max-w-3xl content-start">
      <section class="py-8 first:pt-0" aria-labelledby="overview">
        <h2 id="overview" class="scroll-mt-6 text-2xl font-bold">
          {text.overviewTitle}
        </h2>
        <p class="mt-3">{text.overviewLead}</p>
        {/* Who stands behind the claims, with what the project is: a directory of public aid that does
          not say who keeps it is asking to be taken for an official one. */}
        <h3 class="mt-7 text-xl font-bold">{text.stewardshipTitle}</h3>
        <p class="mt-3">{text.stewardshipLead}</p>
      </section>

      <section class="border-t border-line py-8" aria-labelledby="method">
        <h2 id="method" class="scroll-mt-6 text-2xl font-bold">
          {text.methodTitle}
        </h2>
        <p class="mt-3">{text.criteriaIntro}</p>
        <ul class="mt-3 list-disc space-y-1 ps-6">
          {text.criteriaItems.map((item) => (
            <li>{item}</li>
          ))}
        </ul>
        <p class="mt-5">{text.methodLead}</p>
        {/* Each step is a card rather than a row of a list: they are four separate things that happen to
          every record, not four lines of one definition, and on a page of running text the boxes are
          what says so without a word. */}
        <ol class="mt-6 grid gap-5">
          {text.methodSteps.map(([title, detail]) => (
            <li class="card p-5">
              <h3 class="font-bold">{title}</h3>
              <p class="mt-2">{detail}</p>
            </li>
          ))}
        </ol>
      </section>

      {/* The domain had a life before this inventory, and somebody who followed an old link to it is
        owed that in the open rather than as a surprise. */}
      <section class="border-t border-line py-8" aria-labelledby="history-2016">
        <h2 id="history-2016" class="scroll-mt-6 text-2xl font-bold">
          {text.historySection}
        </h2>
        <p class="mt-3">{text.historyLead}</p>
        <p class="mt-3">{text.historyResultsLead}</p>
        <p class="mt-4">
          <a class="inline-flex min-h-(--spacing-target) items-center font-bold text-brand-strong underline" href={historyPath}>
            {text.historyMore}
          </a>
        </p>
      </section>

      <section class="border-t border-line py-8" aria-labelledby="contact">
        <h2 id="contact" class="scroll-mt-6 text-2xl font-bold">
          {text.contactTitle2}
        </h2>
        {/*
          What to send, as the three things that make a correction checkable without a second message.
          The page used to say "write and say so", which is friendly and leaves the reader to guess what
          would be useful; a correction with no source cannot be acted on here, and saying that up front
          is cheaper for everybody than asking for it afterwards.

          And what not to send: somebody who has been told to check the official source may arrive with
          their own application papers in hand. This site has nothing to do with their application and
          no business holding their documents.
        */}
        <p class="mt-4">{text.contactLead}</p>
        <ol class="mt-3 list-decimal space-y-1 ps-6">
          {text.correctionSteps.map((step) => (
            <li>{step}</li>
          ))}
        </ol>
        <p class="mt-3">{text.noPersonalPapers}</p>
        <p class="mt-4 font-bold">{text.removalLead}</p>
        <p class="mt-4">
          <a class="inline-flex min-h-(--spacing-target) items-center underline" href="mailto:contact@farmsuccession.eu">
            contact@farmsuccession.eu
          </a>
        </p>
      </section>

      <section class="border-t border-line py-8" aria-labelledby="privacy">
        <h2 id="privacy" class="scroll-mt-6 text-2xl font-bold">
          {text.privacyTitle}
        </h2>
        <p class="mt-3">{text.privacyLead}</p>
      </section>

      <section class="border-t border-line py-8" aria-labelledby="licence">
        <h2 id="licence" class="scroll-mt-6 text-2xl font-bold">
          {text.licenceTitle}
        </h2>
        <p class="mt-3">{text.licenceLead}</p>
        <p class="mt-3">
          <a class="underline" href="https://creativecommons.org/licenses/by/4.0/" rel="noopener">
            CC BY 4.0
          </a>
        </p>
      </section>
    </div>

    <OnThisPage sections={sections} language={language} />
  </div>
</SiteLayout>
