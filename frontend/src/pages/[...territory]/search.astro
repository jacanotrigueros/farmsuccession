---
/**
 * Searching, scoped to where the reader is.
 *
 * Two things make this page honest. The first is that it is complete without a search engine: every record
 * in scope is listed below, in the order a territory page lists them, so a reader with no JavaScript — or
 * on a connection that dropped the index — still gets the whole answer rather than an empty box. The
 * search field and the filters are added by the enhancement and hidden until it runs, because a control
 * that cannot do anything is worse than no control.
 *
 * The second is the scope. A territory's search asks the index only for the layers that territory
 * inherits, so searching from Galicia can return a European, a Spanish or a Galician record and never an
 * Andalusian one — not because a rule says so but because the query cannot name it. The European page is
 * the deliberate exception: nothing is above it, so it searches the whole catalogue and says so, and every
 * result carries the territory it applies in.
 */
import ResourceRow from "../../components/ResourceRow.astro";
import TerritoryLayout from "../../layouts/TerritoryLayout.astro";
import {
  countryTerritories,
  euTerritory,
  href,
  hubTerritories,
  languageOf,
  regionTerritories,
  regionsOf,
  view,
  type Territory,
} from "../../lib/corpus.ts";
import { GOALS } from "../../lib/goals.ts";
import { counted, situation, words } from "../../lib/words.ts";

export function getStaticPaths() {
  const europe = euTerritory();
  const all = [...(europe ? [europe] : []), ...countryTerritories(), ...hubTerritories(), ...regionTerritories()];
  return all.map((territory: Territory) => ({
    params: { territory: href(territory.layer).slice(1, -1) || undefined },
    props: { territory },
  }));
}

const { territory } = Astro.props;
const language = languageOf(territory);
const text = words(language);
const here = territory.layer.level === "EU" ? text.europe : territory.data.officialName;

/** The European layer searches everything; every other territory searches what it inherits and owns. */
const whole = territory.layer.level === "EU";
const { layers, resources } = view(territory);
const everything = whole
  ? [...countryTerritories(), ...hubTerritories(), ...regionTerritories()].flatMap((from) =>
      from.data.resources.map((resource) => ({ resource, from, inherited: true })),
    )
  : [];
const listed = [...resources, ...everything];

/** The layers a result may come from. Empty at the European layer, which is how "everything" is said. */
const scope = whole ? [] : layers.map(({ layer }) => href(layer));

const situations = GOALS.map((goal) => ({
  id: goal.id,
  label: situation(goal.id, language).title,
  found: listed.filter(({ resource }) => goal.kinds.some((kind) => kind === resource.kind)).length,
})).filter(({ found }) => found > 0);

const title = whole ? text.searchEverywhere : text.searchHere.replace("{where}", here);
const lead = whole ? text.searchWhole : text.searchScoped.replace("{where}", here);

const sections = [{ id: "everything", label: text.everythingHere, count: listed.length }];
---

<TerritoryLayout
  title={`${title} — ${text.siteName}`}
  description={lead}
  language={language}
  current={href(territory.layer)}
  sections={sections}
>
  <header class="py-10">
    <nav aria-label={text.whereYouAre} class="text-meta text-muted">
      <ol class="flex flex-wrap gap-x-2">
        {layers.map((above) => (
          <li>
            <a href={href(above.layer)} class="inline-flex min-h-(--spacing-target) items-center">
              {above.layer.level === "EU" ? text.europe : above.data.officialName}
            </a>
            <span aria-hidden="true"> ›</span>
          </li>
        ))}
        <li aria-current="page">{text.searchAction}</li>
      </ol>
    </nav>
    <h1 class="page-title mt-2 text-3xl text-balance sm:text-4xl">{title}</h1>
    <p class="mt-4 max-w-3xl text-lg">{lead}</p>
  </header>

  {/*
   * Hidden until the enhancement runs. The script removes `hidden` once the index answers, so a reader
   * whose browser never gets there is never shown a field that cannot search.
   */}
  <form
    id="search"
    role="search"
    hidden
    class="border-t border-line py-6"
    data-search
    data-scope={JSON.stringify(scope)}
    data-language={language}
    data-strings={JSON.stringify({ one: text.result[0], many: text.result[1], nothing: text.nothingMatched, failed: text.searchFailed })}
  >
    <label for="query" class="block font-semibold">
      {text.searchLabel}
    </label>
    <div class="mt-2 flex flex-wrap gap-3">
      <input
        id="query"
        name="q"
        type="search"
        autocomplete="off"
        class="min-h-(--spacing-target) min-w-0 flex-1 rounded-sm border border-line bg-card px-4 py-2 text-lg"
      />
      <button type="submit" class="min-h-(--spacing-target) rounded-sm bg-brand px-5 py-2 font-semibold text-on-brand">
        {text.searchAction}
      </button>
    </div>

    {situations.length > 1 && (
      <fieldset class="mt-5">
        <legend class="font-semibold">{text.narrowDown}</legend>
        <div class="mt-2 flex flex-wrap gap-x-6 gap-y-1">
          {situations.map(({ id, label, found }) => (
            <label class="flex min-h-(--spacing-target) items-center gap-2">
              <input type="checkbox" name="situation" value={id} class="size-5" />
              {label}
              <span class="text-meta text-muted" data-count={id}>
                {found}
              </span>
            </label>
          ))}
          <button type="reset" class="min-h-(--spacing-target) text-brand-strong underline">
            {text.clearFilters}
          </button>
        </div>
      </fieldset>
    )}
  </form>

  <p id="search-state" class="border-t border-line py-4 text-muted" hidden aria-live="polite" data-state></p>

  <section class="border-t border-line py-8" aria-labelledby="results" hidden data-results>
    <h2 id="results" class="scroll-mt-6 text-2xl font-bold" data-results-heading></h2>
    <div class="mt-4" data-results-list></div>
  </section>

  <section class="border-t border-line py-8" aria-labelledby="everything" data-everything>
    <h2 id="everything" class="scroll-mt-6 text-2xl font-bold">
      {text.everythingHere}
    </h2>
    <p class="mt-1 text-meta text-muted">{counted(listed.length, text.record)}</p>
    <noscript>
      <p class="mt-3 max-w-3xl text-muted">{text.searchNeedsScript}</p>
    </noscript>
    <div class="mt-4">
      {listed.map(({ resource, from, inherited }) => (
        <ResourceRow resource={resource} language={language} recordedIn={from} inherited={inherited} />
      ))}
    </div>
  </section>
</TerritoryLayout>

<script is:inline type="module" src="/search.js" defer></script>
