---
/**
 * A single, illustrated recovery page for every unknown route. Static hosting cannot infer a
 * language from a non-existent URL, so present concise English guidance plus links into each
 * country's own language. All exits work without JavaScript or the search index.
 *
 * Do not repeat six copies of the error explanation: the decision is where to go next.
 */
import { Icon } from "astro-icon/components";
import SiteLayout from "../layouts/SiteLayout.astro";
import { countryTerritories, euTerritory, href, languageOf } from "../lib/corpus.ts";
import { ICON } from "../lib/icons.ts";
import { words } from "../lib/words.ts";
import { searchUrl } from "../../public/search-scope.js";

const europe = euTerritory();
if (!europe) throw new Error("no European layer: the recovery page has nowhere to send readers");

const language = languageOf(europe);
const text = words(language);
const ways = countryTerritories()
  .filter((territory) => territory.layer.level === "COUNTRY")
  .map((territory) => ({ territory, language: languageOf(territory), text: words(languageOf(territory)) }));
---

<SiteLayout
  title={`${text.notFoundTitle} · ${text.siteName}`}
  description={text.notFoundText}
  language={language}
  canonical={false}
  noindex
>
  <>
    <section class="border-b border-line bg-card">
      <div class="wrap grid items-center gap-8 py-10 lg:grid-cols-[minmax(0,1fr)_minmax(17rem,25rem)] lg:gap-16 lg:py-16">
        <div>
          <p class="eyebrow">404</p>
          <h1 class="page-title mt-2 text-3xl sm:text-4xl">{text.notFoundTitle}</h1>
          <p class="mt-4 max-w-3xl text-lg text-muted">{text.notFoundText}</p>
          <div class="mt-7 flex flex-wrap items-center gap-3">
            <a href="/" class="btn btn-primary">
              <Icon name="lucide:house" aria-hidden="true" class="size-5 shrink-0" />
              {text.startHere}
            </a>
            <a href={searchUrl("/")} class="btn btn-quiet">
              <Icon name={ICON.search} aria-hidden="true" class="size-5 shrink-0" />
              {text.searchAction}
            </a>
          </div>
        </div>
        <img
          src="/img/404-wayfinding.webp"
          alt=""
          width="768"
          height="512"
          decoding="async"
          class="mx-auto block h-auto w-full max-w-md rounded-2xl"
        />
      </div>
    </section>

    <section class="wrap py-8 sm:py-10" aria-labelledby="countries">
      <h2 id="countries" class="text-xl font-bold">
        {text.countriesTitle}
      </h2>
      <ul class="mt-4 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
        {ways.map(({ territory, language: own, text: here }) => (
          <li lang={own === language ? undefined : own}>
            <a
              href={href(territory.layer)}
              hreflang={own}
              aria-label={`${here.startHere}: ${territory.data.officialName}`}
              class="card card-link flex min-h-(--spacing-target) items-center justify-between gap-3 px-4 py-3 font-bold no-underline"
            >
              {territory.data.officialName}
              <Icon name={ICON.chevron} aria-hidden="true" class="size-5 shrink-0 text-muted" />
            </a>
          </li>
        ))}
      </ul>
    </section>
  </>
</SiteLayout>
