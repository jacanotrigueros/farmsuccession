---
/**
 * Searching inside one country, at the word that country uses for searching.
 *
 * The route is the scope. A national search accepts its own country and the layers it inherits — today the
 * European one — so a European framework shows up in every country and a record of another country never
 * does, because the query cannot name it. A `country` in the query string is ignored here, and a territory
 * belonging to somewhere else is dropped: `search-scope.js` holds that rule, and this page and the
 * reader's browser both read it from there.
 *
 * Nearest first, as a territory filter already lists: the country, its groupings and regions, then the
 * European layer. An empty Polish search used to open on EU records in English.
 */
import SearchView from "../../components/SearchView.astro";
import SiteLayout from "../../layouts/SiteLayout.astro";
import { countryTerritories, euTerritory, hubTerritories, languageOf, regionsOf, view, type Territory } from "../../lib/corpus.ts";
import { facetsFor, type Listed } from "../../lib/facets.ts";
import { bundleLanguages } from "../../lib/catalogue-order.ts";
import { words } from "../../lib/words.ts";
import { SEARCH_SLUGS } from "../../../public/search-scope.js";

export function getStaticPaths() {
  return countryTerritories().map((territory: Territory) => {
    const iso = territory.layer.level === "EU" ? "" : territory.layer.country;
    return { params: { country: iso.toLowerCase(), search: SEARCH_SLUGS[iso] ?? SEARCH_SLUGS.EU }, props: { territory } };
  });
}

const { territory } = Astro.props;
const language = languageOf(territory);
const text = words(language);
const iso = territory.layer.level === "EU" ? "" : territory.layer.country;

const europe = euTerritory();
const inside = [
  territory,
  ...hubTerritories().filter(({ layer }) => layer.level === "HUB" && layer.country === iso),
  ...regionsOf(iso),
  ...(europe ? [europe] : []),
];
const listed: Listed[] = inside.flatMap((from) =>
  from.data.resources.map((resource) => ({ resource, from, inherited: from !== territory })),
);

const languages = bundleLanguages(inside, languageOf);

/**
 * The groupings of this country and the regions each holds, so a search started from Canarias says it is
 * searching Canarias rather than the whole country while it filters by the seven islands (Sol, 28 Nov 2026).
 */
const hubs = hubTerritories()
  .filter(({ layer }) => layer.level === "HUB" && layer.country === iso)
  .map((hub) => ({
    name: hub.data.officialName,
    regions: regionsOf(iso)
      .filter((region) =>
        view(region).layers.some(({ layer }) => layer.level === "HUB" && hub.layer.level === "HUB" && layer.hub === hub.layer.hub),
      )
      .flatMap(({ layer }) => (layer.level === "REGION" ? [`${iso}/${layer.region}`] : [])),
  }))
  .filter(({ regions }) => regions.length > 1);
const name = territory.data.officialName;
const title = text.searchHere.replace("{where}", name);
---

<SiteLayout
  title={`${title} — ${text.siteName}`}
  description={text.browseHint}
  language={language}
  current={`/${iso.toLowerCase()}/`}
  noindex
>
  <SearchView
    language={language}
    crumbs={[
      { label: text.allCountries, href: "/" },
      { label: name, href: `/${iso.toLowerCase()}/` },
    ]}
    title={title}
    place={name}
    country={iso}
    listed={listed}
    facets={facetsFor(listed, language, iso)}
    languages={languages}
    inherits={["EU"]}
    hubs={hubs}
  />
</SiteLayout>
