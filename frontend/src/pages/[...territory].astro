---
/**
 * Every territory below the European layer: a country, a grouping that publishes a layer of its own, and
 * a region. One route, because they are the same page — what differs is how much a reader inherits before
 * reaching it, and that is data.
 *
 * The page opens with where you are and what applies here, then what a reader came to sort out, the
 * territories under it, and the records themselves in two
 * groups: the ones this territory recorded, and the ones that reach it from a wider layer. The split is
 * the point. "This is ours" and "this applies in the whole country" are different answers to the same
 * question, no figure on the page credits a territory with another layer's instruments, and a reader who
 * wants to know which page to watch for a change can see it without opening the record.
 */
import { Icon } from "astro-icon/components";
import { snippet } from "../lib/snippet.ts";
import { codesInBrackets, TITLE_CODES } from "../lib/subdivision.ts";
import AgeComparison from "../components/AgeComparison.astro";
import CountryContext from "../components/CountryContext.astro";
import Needs from "../components/Needs.astro";
import PageHeader from "../components/PageHeader.astro";
import CountryCards from "../components/CountryCards.astro";
import RecordLinks from "../components/RecordLinks.astro";
import TerritoryCard from "../components/TerritoryCard.astro";
import PageIndex from "../components/PageIndex.astro";
import ResourceList from "../components/ResourceList.astro";
import StandaloneNews from "../components/StandaloneNews.astro";
import SearchBox from "../components/SearchBox.astro";
import SiteLayout from "../layouts/SiteLayout.astro";
import {
  subdivisionsOf,
  countryTerritories,
  euTerritory,
  currentEdition,
  EUROPE_PAGE,
  href,
  hubTerritories,
  languageOf,
  localeOf,
  pageOf,
  regionsOf,
  type Territory,
  view,
} from "../lib/corpus.ts";
import { GOALS, isFirstEstablishmentAid } from "../lib/goals.ts";
import { flagOf, ICON } from "../lib/icons.ts";
import { dateIn } from "../lib/language.ts";
import { kindLabel } from "../lib/vocabulary.ts";
import { counted, editionNamed, words } from "../lib/words.ts";
import { queryFromState, searchPath, searchUrl } from "../../public/search-scope.js";

export function getStaticPaths() {
  // Written out here rather than in a helper: Astro lifts this function into a module of its own, where
  // anything declared beside it does not exist.
  const regions = countryTerritories().flatMap(({ layer }) => (layer.level === "EU" ? [] : regionsOf(layer.country)));
  // The European layer has its own page (`/eu/`), built from the same template as every country.
  const europe = euTerritory();
  const all: Territory[] = [...(europe ? [europe] : []), ...countryTerritories(), ...hubTerritories(), ...regions];
  return all.map((territory) => ({ params: { territory: pageOf(territory.layer).slice(1, -1) }, props: { territory } }));
}

const { territory } = Astro.props;
const language = languageOf(territory);
const locale = localeOf(territory);
const text = words(language);
const { layers, resources } = view(territory);
const name = territory.data.officialName;
const context = territory.data.schemaId === "country-snapshot" ? territory.data.countryContext : undefined;
const headlinePercent = new Intl.NumberFormat(locale, { style: "percent", minimumFractionDigits: 1, maximumFractionDigits: 1 });
type AgeTable = { holdings: number; under25: number; from25To34: number; from35To39: number; atLeast65: number };
const olderShare = (table: AgeTable) => table.atLeast65 / table.holdings;
const youngerShare = (table: AgeTable) => (table.under25 + table.from25To34 + table.from35To39) / table.holdings;
const keyFigures = context && {
  title: text.countryContext.keyFigures.replace("{country}", name).replace("{year}", String(context.succession.year)),
  figures: [
    { share: olderShare, label: text.countryContext.olderShare },
    { share: youngerShare, label: text.countryContext.youngerShare },
  ].map(({ share, label }) => ({
    value: headlinePercent.format(share(context.succession)),
    label,
    europe:
      context.succession.europe &&
      text.countryContext.europeAverage.replace("{value}", headlinePercent.format(share(context.succession.europe))),
  })),
};

const country = territory.layer.level === "EU" ? "" : territory.layer.country;
/** A country speaks of itself as a country: what it runs is national, not "its own layer". */
const isCountry = territory.layer.level === "COUNTRY";
/**
 * The territories under this one. A region's grouping is not written on the region — a region is a
 * country and a slug, and which grouping it belongs to is the catalogue's business — so it is read from
 * the layers above it, which is the one place that answer is worked out.
 */
const hubSlug = territory.layer.level === "HUB" ? territory.layer.hub : undefined;
const children =
  territory.layer.level === "COUNTRY"
    ? regionsOf(country)
    : hubSlug === undefined
      ? []
      : regionsOf(country).filter((region) => view(region).layers.some(({ layer }) => layer.level === "HUB" && layer.hub === hubSlug));
const groupings =
  territory.layer.level === "COUNTRY" ? hubTerritories().filter(({ layer }) => layer.level === "HUB" && layer.country === country) : [];

/**
 * The territories of this one, with the ones that belong to a grouping kept inside it.
 *
 * An archipelago or a set of provinces that publishes a layer of its own is not a peer of the regions
 * under it, and listing it as one more link above a flat grid of twenty-eight made a reader work out the
 * relationship from the names. A grouping is a box with its own territories in it, and it says how many
 * records it holds for all of them.
 *
 * The plain territories come first and the groupings after them, rather than each grouping sitting where
 * its first territory would have: a box that spans the three columns in the middle of the grid breaks
 * the rows around it and leaves half-empty lines above and below itself.
 */
const hubOf = (child: Territory): Territory | undefined => view(child).layers.find(({ layer }) => layer.level === "HUB");
const under = [
  ...children
    .filter((child) => territory.layer.level !== "COUNTRY" || hubOf(child) === undefined)
    .map((child) => ({ hub: undefined, members: [child] })),
  ...groupings
    .map((hub) => ({ hub, members: children.filter((child) => hubOf(child) === hub) }))
    .filter(({ members }) => members.length > 0),
];

/**
 * Aid to set up for the first time is what most readers of a country page came for, and in most countries it
 * is convened territory by territory: each territory's card shows its own (TerritoryCard), and the page
 * header leads there (ChatGPT review of /es/, founder 18 Nov 2026).
 */
const showsInstall =
  isCountry && [...children, ...groupings].filter((place) => place.data.resources.some(isFirstEstablishmentAid)).length >= 2;
// A country whose first-establishment aid is national, not regional, points to it the same way (Austria).
const showsNationalInstall = isCountry && !showsInstall && territory.data.resources.some(isFirstEstablishmentAid);

/** What this territory recorded itself, and what reaches it from a wider layer, closest layer first. */
const settled = (status: string): number =>
  status === "ACTIVE" ? 0 : status === "UNKNOWN" || status === "ANNOUNCED_NOT_OPERATING" ? 2 : 1;
const own = resources
  .filter(({ from }) => from === territory)
  .map(({ resource }) => ({ resource, recordedIn: territory }))
  .toSorted((a, b) => settled(a.resource.status) - settled(b.resource.status));
const inheritedGroups = [...layers]
  .toReversed()
  .filter((layer) => layer !== territory)
  .map((layer) => ({
    name: layer.layer.level === "EU" ? text.euName : layer.data.officialName,
    items: resources.filter(({ from }) => from === layer).map(({ resource }) => ({ resource, recordedIn: layer })),
  }))
  .filter(({ items }) => items.length > 0);
const inheritedCount = inheritedGroups.reduce((total, { items }) => total + items.length, 0);

/**
 * Europe's page explains a framework rather than listing services (founder, 16 Nov 2026, from the
 * ChatGPT design he chose): its strongest action is choosing one's country, where the framework turns
 * into aid, training and advice. It drops what only makes sense for a place a farmer applies in — the
 * practical tasks, the search box (which at this level would search every country) and the figures —
 * and keeps the shared header, cards and footer.
 */
const isEurope = territory.layer.level === "EU";
/** A region whose readers name it by codes ("safer 29") carries them after its name: "Bretagne (22, 29, 35, 56)". */
const subdivisions = subdivisionsOf(territory);
const codesText = subdivisions.length > 0 ? ` ${codesInBrackets(subdivisions)}` : "";
const titleWhere = subdivisions.length > 0 && subdivisions.length <= TITLE_CODES ? name + codesText : name;
const pageTitle = isEurope ? text.euTitle : (isCountry ? text.countryTitle : text.territoryTitle).replace("{where}", titleWhere);
/**
 * Europe's page is found by people searching for EU policy and CAP support for young farmers, so its
 * search title and snippet say that; its long introduction stays on the page, where it is read.
 */
const ownMetaTitle = territory.data.schemaId === "eu-snapshot" ? undefined : territory.data.metaTitle;
/**
 * A region's or hub's own search title, written from how people there search for it, already fits a result
 * on its own; only the title the site builds is followed by the site's name.
 */
const metaTitle = isEurope
  ? text.euMetaTitle
  : territory.data.schemaId === "country-snapshot"
    ? (ownMetaTitle ?? text.countryMetaTitle.replace("{where}", name))
    : (ownMetaTitle ?? `${pageTitle} · ${text.siteName}`);
/**
 * A territory's summary is written to be read on the page and ran to 456 characters as a description;
 * without a search description of its own, it is cut to what a result shows, as a record's is.
 */
const metaDescription = isEurope
  ? text.euMetaDescription
  : territory.data.schemaId === "eu-snapshot"
    ? snippet(territory.data.summary)
    : (territory.data.metaDescription ?? snippet(territory.data.summary, codesText ? `${name}${codesText} · ` : ""));
/** A country inherits only from the European layer, so its heading can name it instead of "other scopes". */
const inheritedForms = isCountry ? text.euAppliesIn : text.alsoApplies;
const territoriesTitle = showsInstall ? text.installTerritoriesTitle : text.territoriesTitle;

/** The strip names the sections it leads to. Coverage closes the page and is not one of its answers. */
const sections = [
  isEurope ? { id: "countries", label: text.euCountriesTitle } : { id: "needs", label: text.navNeeds },
  ...(children.length > 0 || groupings.length > 0 ? [{ id: "territories", label: territoriesTitle }] : []),
  ...(isCountry && own.length === 0
    ? []
    : [{ id: "own", label: isCountry ? text.wholeCountryTitle : isEurope ? text.euFrameworkTitle : text.navOwn }]),
  ...(inheritedCount > 0 ? [{ id: "inherited", label: isCountry ? text.euName : text.alsoAppliesNav }] : []),
  ...(context ? [{ id: "country-context", label: text.countryContext.title }] : []),
  ...(territory.data.news.some((item) => !item.resourceIds?.length) ? [{ id: "news", label: text.newsTitle }] : []),
];

/** Everything a search from this page can return, including the records below the national layer. */
const applicable = resources.map(({ resource }) => resource);
const underneath = [...children, ...groupings].flatMap((under) => under.data.resources);
const everythingHere = [...applicable, ...underneath];

/** A count with its noun, in a phrase that names the place it is about. */
const about = (forms: readonly [string, string], howMany: number): string => counted(howMany, forms, locale).replace("{where}", name);

/**
 * A country or grouping with children counts the complete search scope and its territories.
 * A leaf territory answers with the two figures that are actually different there:
 * what was written for it, and what reaches it from a wider layer.
 */
const figures =
  children.length > 0
    ? [
        { icon: ICON.resources, value: everythingHere.length, label: about(text.statApplicable, everythingHere.length) },
        { icon: ICON.territory, value: children.length, label: counted(children.length, text.statTerritories, locale) },
      ]
    : [
        { icon: ICON.resources, value: own.length, label: about(text.statOwn, own.length) },
        // Europe is the top layer: nothing above it can apply there, so "0 from other scopes" says nothing.
        ...(territory.layer.level === "EU"
          ? []
          : [{ icon: ICON.scope, value: inheritedCount, label: about(text.statOtherScopes, inheritedCount) }]),
      ];
/**
 * The kinds something on this page actually is, in the order the lists use, so the control can only ever
 * narrow to something that is there. The catch-all goes last, where a reader looks once nothing above it
 * has fitted.
 */
const lastOf = (kind: string) => (kind === "OTHER" ? 1 : 0);
const kinds = [...new Set([...own, ...inheritedGroups.flatMap(({ items }) => items)].map(({ resource }) => resource.kind))]
  .map((kind) => ({ kind, label: kindLabel(kind, language) }))
  .toSorted((a, b) => lastOf(a.kind) - lastOf(b.kind) || a.label.localeCompare(b.label, language));

/**
 * Regions and groupings can narrow all their cards locally. A country also carries a regional
 * directory, which this filter cannot narrow: its complete national search is the filtering surface
 * instead of a local control that silently ignores most of the country’s resources.
 */
// Europe's records are of several kinds (frameworks, a portal, advice, a network), so a reader can narrow
// them to the one they need rather than reading every card (founder, 17 Nov 2026).
const narrows = kinds.length > 1 && !isCountry;

/** The heading of the records this territory recorded, and the sentence under a country's own. */
const alsoTitle = (inheritedCount === 1 ? inheritedForms[0] : inheritedForms[1])
  .replace("{count}", counted(inheritedCount, text.record, locale))
  .replace("{where}", name);

/**
 * A count the page shows is a count of what the page is showing, and narrowing it changes both. Every
 * figure beside a list carries the two sentences it can be — one record, or several — with the number
 * left out, so the script can say the truth about three records in the language it was written in rather
 * than swap a digit inside a sentence that no longer agrees with itself.
 *
 * A page with nothing to narrow carries none of this: its figures are written once and stay true.
 *
 * The figures at the top of the page are not among them either: they describe the territory, which a
 * filter does not change, and they sit above the control that narrows the lists.
 */
const saying = (template: string, word: string) => template.replace("{count}", `{n} ${word}`).replace("{where}", name);
const howMany = (one: string, many = one) =>
  narrows ? { "data-figure": "", "data-one": saying(one, text.record[0]), "data-many": saying(many, text.record[1]) } : {};
const recordCount = howMany("{count}");

/**
 * Searching from a territory searches its country, with this territory already chosen — never the European
 * search, which would show a reader schemes that do not apply where they are. A country searches itself.
 */
const scopedRegions =
  territory.layer.level === "REGION"
    ? [`${country}/${territory.layer.region}`]
    : territory.layer.level === "HUB"
      ? children.flatMap(({ layer }) => (layer.level === "REGION" ? [`${country}/${layer.region}`] : []))
      : [];
const pinned = scopedRegions.map((value) => ({ name: "territory", value }));
const selected: Record<string, string[]> = scopedRegions.length > 0 ? { territory: scopedRegions } : {};
const pinnedQuery = queryFromState({ selected }, country || undefined);
const searchHere = (kinds: readonly string[]) => searchUrl("/", { country: country || null, selected: { ...selected, kind: [...kinds] } });

/**
 * A region that recorded nothing of its own is left out of search engines' indexes, and stays a page.
 * It is a true and useful page — everything that applies there does apply there — but what it lists is
 * what its sibling regions list, and asking an index to carry twenty-eight copies of one national list is
 * asking it to choose between them. It stays reachable, its links are followed, and it is in no sitemap.
 */
const indexed = territory.layer.level !== "REGION" || own.length > 0;

/** A local reader can point out what this territory-specific research missed without needing GitHub. */
const reportPath = territory.layer.level === "EU" ? `/${text.reportSlug}/` : `/${country.toLowerCase()}/${text.reportSlug}/`;
const reportQuery = new URLSearchParams({ type: "missing", territory: name, from: href(territory.layer) }).toString();
---

<SiteLayout
  title={isEurope ? `${metaTitle} · ${text.siteName}` : metaTitle}
  description={metaDescription}
  language={language}
  current={pageOf(territory.layer)}
  noindex={!indexed}
>
  <PageHeader
    crumbs={
      isEurope
        ? [{ label: text.allCountries, href: "/" }]
        : // The trail is how a reader moves, not how measures are inherited: a country is reached from the
          // overview of every country, the way Europe's own page is, not from inside Europe's page.
          layers
            .slice(0, -1)
            .map((above) =>
              above.layer.level === "EU"
                ? { label: text.allCountries, href: "/" }
                : { label: above.data.officialName, href: pageOf(above.layer) },
            )
    }
    crumbsLabel={text.whereYouAre}
    eyebrow={isEurope ? text.euEyebrow : isCountry ? undefined : `${text.siteName} · ${editionNamed(currentEdition, language)}`}
    title={pageTitle}
    lead={territory.data.summary}
    flag={territory.layer.level === "COUNTRY" ? flagOf(country) : territory.layer.level === "EU" ? flagOf("EU") : undefined}
  >
    {showsInstall && (
      <a href="#territories" class="btn btn-primary mt-4">
        {text.installShortcut}
      </a>
    )}
    {showsNationalInstall && (
      <a href="#own" class="btn btn-primary mt-4">
        {text.installNationalShortcut}
      </a>
    )}
    <div class="mt-8">
      <SearchBox
        action={searchPath("/", country || undefined)}
        id="here"
        label={isEurope ? text.searchAcrossEurope : text.searchHereLabel.replace("{where}", name)}
        button={text.searchAction}
        examples={text.searchExamples}
        pinned={pinned}
      />
      {isEurope ? (
        // A direct way to the framework for a reader who came for it, past a country list that will grow to 27.
        <a href="#own" class="mt-4 inline-flex min-h-(--spacing-target) items-center font-bold underline">
          {text.readEuResources.replace("{n}", String(own.length))}
        </a>
      ) : (
        <p class="mt-4 flex flex-wrap items-center gap-x-6 gap-y-2">
          <a
            href={searchPath("/", country || undefined) + pinnedQuery}
            class="inline-flex min-h-(--spacing-target) items-center font-bold underline"
          >
            {text.browseAll.replace("{where}", name)}
          </a>
        </p>
      )}
    </div>
    {/* Where the country stands on generational renewal, after the way to its aid and the search, which are
        what readers come for (Search Console): two figures a reader can take in at once, each beside the
        EU-27's, with the chart and the other countries a link away (ChatGPT review; founder 20 Nov 2026). */}
    {keyFigures && (
      <div class="mt-8 max-w-3xl" data-key-figures>
        <p class="font-bold">{keyFigures.title}</p>
        <p class="mt-1">{text.countryContext.ageOfManagers}</p>
        <ul class="mt-2 grid gap-3 sm:grid-cols-2">
          {keyFigures.figures.map(({ value, label, europe }) => (
            <li class="card p-4">
              <strong class="block text-3xl text-brand tabular-nums">{value}</strong>
              <span class="mt-1 block">{label}</span>
              {europe && <span class="mt-1 block text-muted">{europe}</span>}
            </li>
          ))}
        </ul>
        <p class="mt-2 flex flex-wrap gap-x-6">
          <a class="inline-flex min-h-(--spacing-target) items-center underline" href="#country-context">
            {text.countryContext.seeChart}
          </a>
          <a class="inline-flex min-h-(--spacing-target) items-center underline" href={`${EUROPE_PAGE}#age-comparison`}>
            {text.countryContext.compare}
          </a>
        </p>
      </div>
    )}
    {!isEurope && !isCountry && (
      <div class="mt-8 rounded-lg bg-page p-5">
        <ul class="grid gap-4 sm:grid-cols-2" aria-label={text.statsLabel}>
          {figures.map((figure) => (
            <li class="flex items-center gap-3">
              <Icon name={figure.icon} aria-hidden="true" class="size-5 shrink-0 text-brand" />
              <p>
                <span class="block text-2xl font-bold text-brand tabular-nums">{figure.value}</span>
                <span class="meta block">{figure.label.replace(`${figure.value} `, "")}</span>
              </p>
            </li>
          ))}
        </ul>
      </div>
    )}
  </PageHeader>

  {/* Two sections are both in sight as the reader scrolls; a strip pointing at them is only one more
      box to read (founder, 16 Nov 2026, on Europe's page). It earns its place from three on. */}
  {sections.length >= 3 && <PageIndex sections={sections} language={language} />}

  {isEurope ? (
    <>
      <section class="border-y border-line bg-brand-tint" aria-labelledby="countries">
        <div class="wrap py-12">
          <h2 id="countries" class="scroll-mt-6 text-2xl font-bold">
            {text.euCountriesTitle}
          </h2>
          <p class="mt-2">{text.euCountriesLead}</p>
          <CountryCards language={language} />
        </div>
      </section>
      <AgeComparison language={language} locale={locale} />
    </>
  ) : (
    <section class="border-y border-line bg-card" aria-labelledby="needs">
      <div class="wrap py-12">
        <Needs
          compact
          showLead={!isCountry}
          resources={everythingHere}
          language={language}
          hrefFor={(goal) => searchHere(GOALS.find(({ id }) => id === goal)?.kinds ?? [])}
          hrefForKind={(kind) => searchHere([kind])}
          kinds={false}
        />
      </div>
    </section>
  )}

  {(children.length > 0 || groupings.length > 0) && (
    <section class:list={["wrap pt-12", isCountry && own.length === 0 && "pb-12"]} aria-labelledby="territories">
      <h2 id="territories" class="flex scroll-mt-6 items-center gap-3 text-2xl font-bold">
        <Icon name={ICON.territory} aria-hidden="true" class="size-6 shrink-0 text-brand" />
        {territoriesTitle}
      </h2>
      <p class="mt-2 max-w-5xl text-muted">{showsInstall ? text.installTerritoriesLead : text.territoriesLead}</p>
      <ul class="territory-list mt-6 gap-2 md:columns-2 md:[&>li]:mb-2 md:[&>li]:break-inside-avoid">
        {under.map(({ hub, members }) => {
          if (!hub) {
            return members.map((child) => <TerritoryCard child={child} language={language} withRecords={isCountry} />);
          }
          const aid = hub.data.resources.filter(isFirstEstablishmentAid);
          const rest = hub.data.resources.filter((resource) => !isFirstEstablishmentAid(resource));
          const groupName = hub.data.officialName;
          return (
            <li class="card p-4 md:[column-span:all]">
              <h3 class="text-lg font-bold">
                <a class="inline-flex min-h-(--spacing-target) items-center underline" href={href(hub.layer)}>
                  {groupName}
                </a>
              </h3>
              {aid.length > 0 && (
                <>
                  <p class="meta mb-2">{text.sharedAcross.replace("{where}", groupName)}</p>
                  <RecordLinks place={hub} language={language} resources={aid} featured />
                </>
              )}
              {rest.length > 0 && (
                <details class="regional-resources border-t border-line">
                  <summary class="flex min-h-(--spacing-target) cursor-pointer list-none items-center justify-between gap-3 px-4 text-brand-strong">
                    {(aid.length > 0 ? text.moreSharedRecords : text.showSharedRecords).replace(
                      "{n}",
                      new Intl.NumberFormat(locale).format(rest.length),
                    )}
                    <Icon name={ICON.chevronDown} aria-hidden="true" class="group-chevron size-5 shrink-0" />
                  </summary>
                  <RecordLinks place={hub} language={language} resources={rest} />
                </details>
              )}
              <ul class="territory-list mt-3 gap-2 md:columns-2 md:[&>li]:mb-2 md:[&>li]:break-inside-avoid">
                {members.map((child) => (
                  <TerritoryCard child={child} language={language} withRecords={isCountry} grouping={groupName} />
                ))}
              </ul>
            </li>
          );
        })}
      </ul>
    </section>
  )}

  {!(isCountry && own.length === 0) && (
    <section class="wrap py-12" aria-labelledby="own">
      <h2 id="own" class="flex scroll-mt-6 flex-wrap items-baseline gap-x-3 text-2xl font-bold">
        {isCountry ? text.wholeCountryTitle : isEurope ? text.euFrameworkTitle : text.ownRecords.replace("{where}", name)}
        {own.length > 0 && !isCountry && (
          <span class="meta font-normal" {...recordCount}>
            {counted(own.length, text.record, locale)}
          </span>
        )}
      </h2>
      {isCountry && own.length > 0 && <p class="mt-2 max-w-5xl text-muted">{text.wholeCountryLead}</p>}
      {/*
        Narrowing where the records are. Everything here is already on the page a reader is looking at,
        and until now the only way to see one kind of it was to leave for the search and come back. The
        control offers the kinds this page actually holds, and carries no counts: the figures are at the
        top of the page, and a number on a control is one more thing to read before it can be used.
      */}
      {narrows && (
        <div hidden data-filter class="mt-6 flex flex-wrap items-center gap-3">
          <label for="only" class="font-bold">
            {text.filterByKind}
          </label>
          <select
            id="only"
            name="only"
            class="min-h-(--spacing-target) max-w-full rounded-lg border-2 border-line-strong bg-card px-3 py-2 focus:border-brand"
          >
            <option value="">{text.allKinds}</option>
            {kinds.map(({ kind, label }) => (
              <option value={kind}>{label}</option>
            ))}
          </select>
        </div>
      )}
      {own.length > 0 ? (
        <div class="mt-6">
          <ResourceList items={own} language={language} />
        </div>
      ) : (
        <p class="mt-3">{text.noneOwn.replace("{where}", name)}</p>
      )}
      {/*
        What is left when the choice empties this list. It can only ever be read next to records of
        another scope further down the page — the control offers no kind this page does not hold — so it
        says where those are rather than leaving a heading above nothing.
      */}
      {narrows && own.length > 0 && inheritedCount > 0 && (
        <p hidden data-none class="mt-6">
          {text.noneOfThisKind}
        </p>
      )}
    </section>
  )}

  {inheritedCount > 0 && (
    <section class="wrap pb-12" aria-labelledby="inherited">
      <h2 id="inherited" class="scroll-mt-6 text-2xl font-bold" {...howMany(inheritedForms[0], inheritedForms[1])}>
        {alsoTitle}
      </h2>
      <p class="meta mt-2 max-w-5xl">{isCountry ? text.euAppliesLead : text.alsoAppliesLead}</p>
      {inheritedGroups.map(({ name: from, items }) => (
        <details data-record-group class="inherited-group mt-6 border-t border-line pt-4" open>
          <summary class="flex min-h-(--spacing-target) cursor-pointer list-none items-center gap-3">
            <h3 data-layer class="flex flex-wrap items-baseline gap-x-2 text-xl font-bold">
              {from}
              <span class="meta font-normal">
                {" · "}
                <span {...recordCount}>{counted(items.length, text.record, locale)}</span>
              </span>
            </h3>
            <Icon name={ICON.chevronDown} aria-hidden="true" class="group-chevron ml-auto size-5 shrink-0 text-brand-strong" />
          </summary>
          <div class="mt-4">
            <ResourceList items={items} language={language} level="h4" country={country || undefined} />
          </div>
        </details>
      ))}
    </section>
  )}

  {context && <CountryContext context={context} language={language} locale={locale} name={name} />}

  <StandaloneNews items={territory.data.news} language={language} locale={locale} />

  <section class="wrap border-t border-line py-8" aria-labelledby="coverage">
    <h2 id="coverage" class="flex scroll-mt-6 items-center gap-2 text-lg font-bold">
      <Icon name={ICON.sources} aria-hidden="true" class="size-5 shrink-0 text-brand" />
      {text.sourcesTitle}
    </h2>
    <p class="mt-2 max-w-5xl text-muted">{text.sourcesLead}</p>
    {territory.data.limitations.length > 0 && (
      <ul id="limits" class="mt-2 list-disc space-y-1 ps-6 text-muted" aria-label={text.notCoveredYet}>
        {territory.data.limitations.map((limitation) => (
          <li>{limitation}</li>
        ))}
      </ul>
    )}
    <div class="mt-4 flex flex-wrap items-center gap-x-5 gap-y-2">
      <a class="btn btn-quiet" rel="nofollow" href={`${reportPath}?${reportQuery}`}>
        {text.reportOpenForm}
      </a>
      {isCountry && (
        <a class="inline-flex min-h-(--spacing-target) items-center underline" href={`/${country.toLowerCase()}/${text.aboutSlug}/#method`}>
          {text.methodTitle}
        </a>
      )}
    </div>
    {!isCountry && (
      <p class="meta mt-6">
        {editionNamed(currentEdition, language)} · {text.publishedOn}{" "}
        <time datetime={territory.data.published}>{dateIn(territory.data.published, locale)}</time>
      </p>
    )}
  </section>
  {narrows && <script is:inline type="module" src="/filter.js" defer />}
</SiteLayout>

<style>
  /*
    From a tablet up, the territories flow down two columns, so a short card sits under the one above it
    rather than beside a long one: a grid's rows left a hole as tall as the longest card next to every
    short one. A grouping spans both columns and starts below them.

    On a phone, twenty-eight boxes are twenty-eight screens: the same list, as divided rows.
  */
  @media (max-width: 599px) {
    .territory-list {
      gap: 0;
    }
    .territory-list > :global(li.territory) {
      border-width: 0 0 1px;
      border-radius: 0;
    }
    .territory-list > :global(li.territory:first-child) {
      border-top-width: 1px;
    }
  }
  .regional-resources > summary::-webkit-details-marker,
  .inherited-group > summary::-webkit-details-marker {
    display: none;
  }
  .regional-resources[open] > summary :global(.group-chevron),
  .inherited-group[open] > summary :global(.group-chevron) {
    transform: rotate(180deg);
  }
</style>
