---
/**
 * Every territory below the European layer: a country, a grouping that publishes a layer of its own, and
 * a region. One route, because they are the same page — what differs is how much a reader inherits before
 * reaching it, and that is data.
 *
 * The page is a band that says where you are and what applies here, a strip of its own sections, the
 * territories under it, what a reader might have come to sort out, and then the records themselves in two
 * groups: the ones this territory recorded, and the ones that reach it from a wider layer. The split is
 * the point. "This is ours" and "this applies in the whole country" are different answers to the same
 * question, no figure on the page credits a territory with another layer's instruments, and a reader who
 * wants to know which page to watch for a change can see it without opening the record.
 */
import { Icon } from "astro-icon/components";
import DraftNotice from "../components/DraftNotice.astro";
import Needs from "../components/Needs.astro";
import PageHeader from "../components/PageHeader.astro";
import PageIndex from "../components/PageIndex.astro";
import ResourceList from "../components/ResourceList.astro";
import SearchBox from "../components/SearchBox.astro";
import SiteLayout from "../layouts/SiteLayout.astro";
import {
  countryTerritories,
  currentEdition,
  href,
  hubTerritories,
  isDraft,
  languageOf,
  regionsOf,
  type Territory,
  view,
} from "../lib/corpus.ts";
import { GOALS } from "../lib/goals.ts";
import { flagOf, ICON } from "../lib/icons.ts";
import { dateIn } from "../lib/language.ts";
import { counted, editionNamed, words } from "../lib/words.ts";
import { queryFromState, searchPath, searchUrl } from "../../public/search-scope.js";

export function getStaticPaths() {
  // Written out here rather than in a helper: Astro lifts this function into a module of its own, where
  // anything declared beside it does not exist.
  const regions = countryTerritories().flatMap(({ layer }) => (layer.level === "EU" ? [] : regionsOf(layer.country)));
  const all: Territory[] = [...countryTerritories(), ...hubTerritories(), ...regions];
  return all.map((territory) => ({ params: { territory: href(territory.layer).slice(1, -1) }, props: { territory } }));
}

const { territory } = Astro.props;
const language = languageOf(territory);
const text = words(language);
const { layers, resources } = view(territory);
const name = territory.data.officialName;

const country = territory.layer.level === "EU" ? "" : territory.layer.country;
/**
 * The territories under this one. A region's grouping is not written on the region — a region is a
 * country and a slug, and which grouping it belongs to is the catalogue's business — so it is read from
 * the layers above it, which is the one place that answer is worked out.
 */
const hubSlug = territory.layer.level === "HUB" ? territory.layer.hub : undefined;
const children =
  territory.layer.level === "COUNTRY"
    ? regionsOf(country)
    : hubSlug === undefined
      ? []
      : regionsOf(country).filter((region) => view(region).layers.some(({ layer }) => layer.level === "HUB" && layer.hub === hubSlug));
const groupings = territory.layer.level === "COUNTRY" ? hubTerritories().filter(({ layer }) => layer.country === country) : [];

/**
 * The territories of this one, with the ones that belong to a grouping kept inside it.
 *
 * An archipelago or a set of provinces that publishes a layer of its own is not a peer of the regions
 * under it, and listing it as one more link above a flat grid of twenty-eight made a reader work out the
 * relationship from the names. A grouping is a box with its own territories in it, and it says how many
 * records it holds for all of them. A region that belongs to no grouping is a card on its own, and the
 * order is the catalogue's: a grouping appears where its first territory would have.
 */
const hubOf = (child: Territory): Territory | undefined => view(child).layers.find(({ layer }) => layer.level === "HUB");
const placed = new Set<Territory>();
const under = children.flatMap((child) => {
  const hub = hubOf(child);
  if (hub === undefined) return [{ hub: undefined, members: [child] }];
  if (placed.has(hub)) return [];
  placed.add(hub);
  return [{ hub, members: children.filter((each) => hubOf(each) === hub) }];
});

/** What this territory recorded itself, and what reaches it from a wider layer, closest layer first. */
const own = resources.filter(({ from }) => from === territory).map(({ resource }) => ({ resource, recordedIn: territory }));
const inheritedGroups = [...layers]
  .toReversed()
  .filter((layer) => layer !== territory)
  .map((layer) => ({
    name: layer.layer.level === "EU" ? text.europe : layer.data.officialName,
    items: resources.filter(({ from }) => from === layer).map(({ resource }) => ({ resource, recordedIn: layer })),
  }))
  .filter(({ items }) => items.length > 0);
const inheritedCount = inheritedGroups.reduce((total, { items }) => total + items.length, 0);

const sections = [
  ...(children.length > 0 || groupings.length > 0 ? [{ id: "territories", label: text.territoriesTitle, count: children.length }] : []),
  { id: "needs", label: text.whatDoYouNeed },
  { id: "own", label: text.ownRecords.replace("{where}", name), count: own.length },
  ...(inheritedCount > 0 ? [{ id: "inherited", label: text.alsoAppliesNav, count: inheritedCount }] : []),
  ...(territory.data.limitations.length > 0 ? [{ id: "limits", label: text.limits }] : []),
  { id: "coverage", label: text.coverageNote },
];

/**
 * What applies anywhere at or below this territory, which is what "applicable here" means on a page that
 * has territories under it: a reader on Spain is being told what the whole of Spain documents, not only
 * what the state wrote. The line under the figures says how that total breaks down, because the page
 * itself lists the records of this layer and names the territories that hold the rest.
 *
 * Every figure is counted from what the page is about to show rather than read from the file. The
 * territories line only appears where there are any, because "0 territories" is noise on a region.
 */
const applicable = resources.map(({ resource }) => resource);
const underneath = [...children, ...groupings].flatMap((under) => under.data.resources);
const below = underneath.length;
/** Everything a search from this page can return, which is what its figures and its guide are about. */
const everythingHere = [...applicable, ...underneath];
const cited = new Set(everythingHere.flatMap(({ sources }) => sources.map(({ url }) => url))).size;
const figures = [
  { icon: ICON.resources, value: everythingHere.length, label: counted(everythingHere.length, text.statApplicable) },
  ...(children.length > 0 ? [{ icon: ICON.territory, value: children.length, label: counted(children.length, text.statTerritories) }] : []),
  { icon: ICON.sources, value: cited, label: counted(cited, text.statSources) },
];
const split = (children.length > 0 ? text.ownBelowAndInherited : text.ownAndInherited)
  .replace("{own}", String(own.length))
  .replace("{below}", String(below))
  .replace("{inherited}", String(inheritedCount));

/**
 * Searching from a territory searches its country, with this territory already chosen — never the European
 * search, which would show a reader schemes that do not apply where they are. A country searches itself.
 */
const pinned = territory.layer.level === "REGION" ? [{ name: "territory", value: `${country}/${territory.layer.region}` }] : [];
const selected = Object.fromEntries(pinned.map((field) => [field.name, [field.value]]));
const pinnedQuery = queryFromState({ selected }, country || undefined);
const searchHere = (kinds: readonly string[]) => searchUrl("/", { country: country || null, selected: { ...selected, kind: [...kinds] } });

/**
 * A region that recorded nothing of its own is left out of search engines' indexes, and stays a page.
 * It is a true and useful page — everything that applies there does apply there — but what it lists is
 * what its sibling regions list, and asking an index to carry twenty-eight copies of one national list is
 * asking it to choose between them. It stays reachable, its links are followed, and it is in no sitemap.
 */
const indexed = territory.layer.level !== "REGION" || own.length > 0;
---

<SiteLayout
  title={`${text.territoryTitle.replace("{where}", name)} · ${text.siteName}`}
  description={territory.data.summary}
  language={language}
  current={href(territory.layer)}
  noindex={!indexed}
>
  <PageHeader
    crumbs={layers.slice(0, -1).map((above) => ({
      label: above.layer.level === "EU" ? text.europe : above.data.officialName,
      href: href(above.layer),
    }))}
    crumbsLabel={text.whereYouAre}
    eyebrow={`${text.siteName} · ${editionNamed(currentEdition, language)}`}
    title={text.territoryTitle.replace("{where}", name)}
    lead={territory.data.summary}
    flag={territory.layer.level === "COUNTRY" ? flagOf(country) : undefined}
  >
    {isDraft(territory) && (
      <div class="mt-6">
        <DraftNotice language={language} />
      </div>
    )}
    <div class="mt-8">
      <SearchBox
        action={searchPath("/", country || undefined)}
        id="here"
        label={text.searchHereLabel.replace("{where}", name)}
        button={text.searchAction}
        examples={text.searchExamples}
        pinned={pinned}
      />
      <a
        href={searchPath("/", country || undefined) + pinnedQuery}
        class="mt-4 inline-flex min-h-(--spacing-target) items-center font-bold underline"
      >
        {text.browseAll.replace("{where}", name)}
      </a>
    </div>
    <div class="mt-8 rounded-lg bg-page p-5">
      <ul class="grid grid-cols-2 gap-4 sm:grid-cols-3" aria-label={text.statsLabel}>
        {figures.map((figure) => (
          <li class="flex items-center gap-3">
            <Icon name={figure.icon} aria-hidden="true" class="size-5 shrink-0 text-brand" />
            <p>
              <span class="block text-2xl font-bold text-brand tabular-nums">{figure.value}</span>
              <span class="meta block">{figure.label.replace(`${figure.value} `, "")}</span>
            </p>
          </li>
        ))}
      </ul>
      <p class="meta mt-4 border-t border-line pt-4">{split}</p>
    </div>
  </PageHeader>

  <PageIndex sections={sections} language={language} />

  {(children.length > 0 || groupings.length > 0) && (
    <section class="wrap py-12" aria-labelledby="territories">
      <h2 id="territories" class="scroll-mt-6 text-2xl font-bold">
        {text.territoriesTitle}
      </h2>
      <ul class="territory-list mt-6 grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-3">
        {under.map(({ hub, members }) =>
          hub ? (
            <li class="card p-4 sm:col-span-2 lg:col-span-3">
              <h3 class="text-lg font-bold">
                <a href={href(hub.layer)}>{hub.data.officialName}</a>
              </h3>
              {hub.data.resources.length > 0 && <p class="meta mt-1">{counted(hub.data.resources.length, text.sharedRecords)}</p>}
              <ul class="territory-list mt-3 grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-3">
                {members.map((child) => (
                  <li>
                    <a href={href(child.layer)} class="territory-link card card-link">
                      <span class="font-bold text-ink">{child.data.officialName}</span>
                      <span class="meta">
                        {text.territoryCounts
                          .replace("{own}", String(child.data.resources.length))
                          .replace("{total}", String(view(child).resources.length))}
                      </span>
                    </a>
                  </li>
                ))}
              </ul>
            </li>
          ) : (
            members.map((child) => (
              <li>
                <a href={href(child.layer)} class="territory-link card card-link">
                  <span class="font-bold text-ink">{child.data.officialName}</span>
                  <span class="meta">
                    {text.territoryCounts
                      .replace("{own}", String(child.data.resources.length))
                      .replace("{total}", String(view(child).resources.length))}
                  </span>
                </a>
              </li>
            ))
          ),
        )}
      </ul>
    </section>
  )}

  <section class="border-y border-line bg-card" aria-labelledby="needs">
    <div class="wrap py-12">
      <Needs
        resources={everythingHere}
        language={language}
        hrefFor={(goal) => searchHere(GOALS.find(({ id }) => id === goal)?.kinds ?? [])}
        hrefForKind={(kind) => searchHere([kind])}
      />
    </div>
  </section>

  <section class="wrap py-12" aria-labelledby="own">
    <h2 id="own" class="flex scroll-mt-6 flex-wrap items-baseline gap-x-3 text-2xl font-bold">
      {text.ownRecords.replace("{where}", name)}
      {own.length > 0 && <span class="meta font-normal">{counted(own.length, text.record)}</span>}
    </h2>
    {own.length > 0 ? (
      <div class="mt-6">
        <ResourceList items={own} language={language} />
      </div>
    ) : (
      <p class="mt-3">{text.noneOwn.replace("{where}", name)}</p>
    )}
  </section>

  {inheritedCount > 0 && (
    <section class="wrap pb-12" aria-labelledby="inherited">
      <h2 id="inherited" class="scroll-mt-6 text-2xl font-bold">
        {text.alsoApplies.replace("{where}", name)}
      </h2>
      <p class="meta mt-2">{text.alsoAppliesLead}</p>
      {inheritedGroups.map(({ name: from, items }) => (
        <details class="inherited-group mt-6 border-t border-line pt-4" open>
          <summary class="flex min-h-(--spacing-target) cursor-pointer list-none items-center gap-3">
            <h3 data-layer class="flex flex-wrap items-baseline gap-x-2 text-xl font-bold">
              {from}
              <span class="meta font-normal">{counted(items.length, text.record)}</span>
            </h3>
            <Icon name={ICON.chevronDown} aria-hidden="true" class="group-chevron ml-auto size-5 shrink-0 text-brand-strong" />
          </summary>
          <div class="mt-4">
            <ResourceList items={items} language={language} level="h4" />
          </div>
        </details>
      ))}
    </section>
  )}

  {territory.data.limitations.length > 0 && (
    <section class="wrap pb-12" aria-labelledby="limits">
      <div class="card p-6 sm:p-8">
        <h2 id="limits" class="flex scroll-mt-6 items-center gap-2 text-2xl font-bold">
          <Icon name={ICON.limits} aria-hidden="true" class="size-6 shrink-0 text-accent" />
          {text.limits}
        </h2>
        <ul class="mt-3 list-disc space-y-2 ps-6">
          {territory.data.limitations.map((limitation) => (
            <li>{limitation}</li>
          ))}
        </ul>
      </div>
    </section>
  )}

  <section class="wrap border-t border-line py-8" aria-labelledby="coverage">
    <h2 id="coverage" class="scroll-mt-6 text-lg font-bold">
      {text.coverageNote}
    </h2>
    {/* The last paragraph of the page, with nothing beside it: held to a reading measure it read as
      pushed into the corner, so it takes the width of the section it closes. */}
    <p class="mt-2 text-muted">{territory.data.coverage.note}</p>
    <p class="mt-6 text-meta text-muted">
      {editionNamed(currentEdition, language)} · {text.publishedOn}{" "}
      <time datetime={territory.data.published}>{dateIn(territory.data.published, language)}</time>
    </p>
  </section>
</SiteLayout>

<style>
  /* A territory is a card with a chevron: the whole box is the target, and the arrow says it leads
     somewhere. The count under the name is the territory's own records, not what it inherits. */
  .territory-link {
    position: relative;
    display: flex;
    height: 100%;
    flex-direction: column;
    justify-content: center;
    gap: 0.25rem;
    padding: 0.875rem 2.5rem 0.875rem 1rem;
    text-decoration: none;
  }
  .territory-link::after {
    content: "";
    position: absolute;
    top: calc(50% - 0.25rem);
    right: 1rem;
    width: 0.5rem;
    height: 0.5rem;
    border-top: 2px solid var(--color-brand);
    border-right: 2px solid var(--color-brand);
    transform: rotate(45deg);
  }
  .territory-link:hover,
  .territory-link:focus-visible {
    background: var(--color-brand-tint);
  }
  /* On a phone, twenty-eight boxes are twenty-eight screens: the same list, as rows of about 60px. */
  @media (max-width: 599px) {
    .territory-list {
      gap: 0;
    }
    .territory-list > li > .territory-link {
      min-height: 3.75rem;
      padding-block: 0.5rem;
      border-width: 0 0 1px;
      border-radius: 0;
    }
    .territory-list > li:first-child > .territory-link {
      border-top-width: 1px;
    }
  }
  .inherited-group > summary::-webkit-details-marker {
    display: none;
  }
  .inherited-group[open] > summary :global(.group-chevron) {
    transform: rotate(180deg);
  }
</style>
