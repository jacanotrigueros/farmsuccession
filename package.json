{
  "name": "farmsuccession",
  "version": "0.1.0",
  "description": "Yearly, source-linked editions of public information about farm succession, access to land, aid and training in Europe — data, validators and static site for farmsuccession.eu",
  "type": "module",
  "private": true,
  "license": "CC-BY-4.0",
  "author": "José Antonio Cano Trigueros <contact@farmsuccession.eu>",
  "homepage": "https://farmsuccession.eu/",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "prepare": "husky",
    "types": "node scripts/generate-types.ts",
    "types:check": "node scripts/generate-types.ts --check",
    "checksums:edition": "node scripts/edition-checksums.ts",
    "validate": "node src/validate.ts",
    "check:sources": "node src/check-sources.ts",
    "check:links": "node src/check-links.ts",
    "check:territory": "node src/check-territory.ts",
    "measure": "node scripts/measure.ts",
    "measure:recency": "node scripts/measure-recency.ts",
    "measure:discovery": "node scripts/measure-discovery.ts",
    "report": "node scripts/report.ts",
    "report:check": "node scripts/report.ts --check",
    "report:sources": "node scripts/report-sources.ts",
    "prompt": "node src/prompt.ts",
    "ingest": "node src/ingest.ts",
    "diff": "node src/diff.ts",
    "typecheck": "tsc",
    "lint": "oxlint --type-aware --deny-warnings src test scripts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test \"test/**/*.test.ts\"",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run types:check && npm test && npm run validate && npm run report:check"
  },
  "lint-staged": {
    "*": "prettier --ignore-unknown --write"
  },
  "devDependencies": {
    "@types/node": "24.19.0",
    "husky": "9.1.7",
    "json-schema-to-typescript": "16.0.0",
    "lint-staged": "17.6.0",
    "oxlint": "1.86.0",
    "oxlint-tsgolint": "7.0.2003",
    "prettier": "3.9.9",
    "prettier-plugin-astro": "1.1.0",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "entities": "8.1.0",
    "unpdf": "1.8.1"
  }
}
